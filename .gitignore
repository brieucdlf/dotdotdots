# env / secrets — jamais committés, vivent dans le repo mais ignorés
common/.config/bash/local.bash
common/.config/ghostty/local.conf
common/.config/git/work.gitconfig
common/.config/zed/.env

# claude code session files
.claude/settings.local.json

# tmux plugins (installés par tpm au bootstrap)
common/.config/tmux/plugins
tmux-client*.log

# thèmes installés depuis Zed lui-même : ~/.config/zed est un lien vers ce
# dossier, donc tout ce que Zed écrit atterrit ici. Seule la config est suivie.
common/.config/zed/themes/

# nvim — garder uniquement les fichiers de config, pas les dépendances
common/.config/nvim/LICENSE
common/.config/nvim/README.md
common/.config/nvim/lazy-lock.json
common/.config/nvim/plugin/
common/.config/nvim/.git
common/.config/nvim/.github
common/.config/nvim/.gitignore
common/.config/nvim/.ignore

# fonts
getnf
