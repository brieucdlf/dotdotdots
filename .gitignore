# env / secrets — jamais committés, vivent dans le repo mais ignorés
common/.config/bash/local.bash
common/.config/ghostty/local.conf
common/.config/git/work.gitconfig
common/.config/zed/.env

# claude code session files
.claude/settings.local.json

# bloc autoMode de Claude Code : contexte de travail (dépôt privé, bases Notion,
# données personnelles) extrait par le filtre git — ne doit jamais être committé.
# Voir .gitattributes et .githooks/claude-settings-filter.
common/.claude/settings.private.json

# tmux plugins (installés par tpm au bootstrap)
common/.config/tmux/plugins
tmux-client*.log

# thèmes installés depuis Zed lui-même : ~/.config/zed est un lien vers ce
# dossier, donc tout ce que Zed écrit atterrit ici. Seule la config est suivie.
common/.config/zed/themes/

# nvim — garder uniquement les fichiers de config, pas les dépendances
common/.config/nvim/LICENSE
common/.config/nvim/README.md
common/.config/nvim/lazy-lock.json
common/.config/nvim/plugin/
common/.config/nvim/.git
common/.config/nvim/.github
common/.config/nvim/.gitignore
common/.config/nvim/.ignore

# fonts
getnf

# vie privée : rien qui nomme l'employeur, les projets internes ou l'identité
# n'est committé. Les .sample committés à côté montrent la structure.
common/.config/bash/work.bash
common/.config/git/identity.gitconfig
common/.config/zed/mcp.json
common/.local/bin/dev-tmux

# ~/.ssh — seul `config` est suivi. Refus par défaut : si un jour stow plie le
# dossier en lien vers le dépôt, une clé privée déposée là est ignorée d'office
# plutôt que committée sur un dépôt public.
common/.ssh/*
!common/.ssh/config

# secrets/ — refus par défaut. Seuls le manifeste, les clés PUBLIQUES et les
# fichiers CHIFFRÉS sont suivis ; tout le reste est ignoré, y compris un clair
# déposé là par mégarde ou un .partial laissé par un déchiffrement interrompu.
# L'inverse (ignorer au cas par cas) laisse la faute possible ; ici elle ne
# l'est pas.
secrets/*
!secrets/manifest
!secrets/recipients.txt
!secrets/*.age
!secrets/README.md
