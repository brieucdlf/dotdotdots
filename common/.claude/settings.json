{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git merge-base:*)",
      "Bash(git blame:*)",
      "Bash(git worktree list:*)",
      "Bash(git remote -v:*)",
      "Bash(git tag -v:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(nvim:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(go:*)",
      "Read(~/.config/nvim/**)",
      "Read(~/todo/**)"
    ],
    "deny": [
      "Read(~/Documents/**)",
      "Read(~/Pictures/**)",
      "Read(~/Downloads/**)",
      "Read(~/Music/**)",
      "Read(~/Videos/**)"
    ],
    "ask": [
      "Bash(git commit --no-gpg-sign:*)",
      "Bash(git -c commit.gpgsign=false:*)",
      "Bash(git -c tag.gpgsign=false:*)"
    ]
  },
  "disableClaudeAiConnectors": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/rogemon/.claude/skills/gstack/hosts/claude/hooks/timeline-stop-hook",
            "timeout": 5
          }
        ],
        "_gstack_source": "gstack-timeline-stop"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(AskUserQuestion|mcp__.*__AskUserQuestion)",
        "hooks": [
          {
            "type": "command",
            "command": "/home/rogemon/.claude/skills/gstack/hosts/claude/hooks/question-log-hook",
            "timeout": 5
          }
        ],
        "_gstack_source": "plan-tune-cathedral"
      },
      {
        "matcher": "(AskUserQuestion|mcp__.*__AskUserQuestion)",
        "hooks": [
          {
            "type": "command",
            "command": "/home/rogemon/.claude/skills/gstack/hosts/claude/hooks/auq-error-fallback-hook",
            "timeout": 5
          }
        ],
        "_gstack_source": "auq-error-fallback"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "(AskUserQuestion|mcp__.*__AskUserQuestion)",
        "hooks": [
          {
            "type": "command",
            "command": "/home/rogemon/.claude/skills/gstack/hosts/claude/hooks/question-preference-hook",
            "timeout": 5
          }
        ],
        "_gstack_source": "plan-tune-cathedral"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "diagram-design@diagram-design": true
  },
  "extraKnownMarketplaces": {
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "model": "opus"
}
