# Config SSH — versionnée. Les clés, elles, ne le sont jamais.
#
# L'ORDRE COMPTE, et pas dans le sens qu'on croit : ssh retient la PREMIÈRE
# valeur rencontrée pour chaque option, jamais la dernière. Les blocs nommés
# passent donc avant `Host *`, qui ne joue que le rôle de filet.
#
# Rien ici ne réécrit les défauts d'OpenSSH 9.x en matière de chiffrement :
# ils sont bons, et une liste d'algorithmes figée dans un dépôt vieillit mal.

Host github.com
  User git

  # Épinglé sur les YubiKeys. Pousser exige une présence physique : la clé
  # privée ne sort jamais de l'applet FIDO du token, donc une machine volée ne
  # peut plus rien publier sous cette identité.
  #
  # DEUX clés, dans l'ordre d'usage — une clé sk est liée à UN token, là où la
  # chaîne age accepte les deux. Sans doublon, perdre le token c'est perdre
  # l'accès. Ssh essaie la première, passe à la suivante si elle est absente,
  # et ignore sans bruit un fichier qui n'existe pas encore.
  #
  # Ici le cumul d'IdentityFile est voulu, contrairement au bloc négatif plus
  # bas : ce qui rendait le repli dangereux, c'était de retomber sur une clé
  # LOGICIELLE, volable. Entre deux clés matérielles il ne dégrade rien.
  #
  # Ces noms sont laids EXPRÈS : ce sont ceux que `ssh-keygen -K` recrée seul
  # à partir de la chaîne `application`, sur une machine neuve. Un nom lisible
  # ici, c'est un renommage à la main le jour du reset. Les clés étant
  # RÉSIDENTES, le token est sa propre sauvegarde : rien à mettre dans
  # secrets/, et pas d'amorce circulaire (la clé SSH n'est pas dans le dépôt
  # qu'il faudrait SSH pour cloner).
  IdentityFile ~/.ssh/id_ed25519_sk_rk_github-usbc  # USB-C, quotidien
  IdentityFile ~/.ssh/id_ed25519_sk_rk_github-usba  # USB-A, coffre

  # Indispensable, pas décoratif : sans lui ssh proposerait aussi la clé
  # logicielle que l'agent tient en mémoire, GitHub l'accepterait, et
  # l'épinglage ci-dessus ne vaudrait plus rien.
  IdentitiesOnly yes

# Bloc NÉGATIF, et c'est le point délicat du fichier : `IdentityFile` est la
# seule option de ce fichier qui soit CUMULATIVE au lieu de premier-gagnant.
# Placée dans `Host *`, la clé logicielle s'AJOUTERAIT à celle de github.com ;
# ssh tenterait la YubiKey puis retomberait dessus dès le token débranché, et
# GitHub l'accepterait. L'épinglage ci-dessus ne vaudrait plus rien. Vérifiable
# d'un `ssh -G github.com` : une seule ligne identityfile doit en sortir.
Host * !github.com
  IdentityFile ~/.ssh/id_ed25519_heartbeat

Host *
  # Ne proposer que les clés explicitement nommées. Par défaut, ssh présente à
  # chaque serveur toutes les identités de l'agent : c'est un inventaire de tes
  # clés offert à n'importe quel hôte auquel tu te connectes.
  IdentitiesOnly yes

  # Charge la clé dans l'agent au premier usage plutôt qu'à chaque connexion.
  AddKeysToAgent yes

  # Multiplexage. La première connexion vers un hôte porte les suivantes
  # pendant 10 min : sur github.com, ça veut dire UN touch de YubiKey pour une
  # rafale de push, au lieu d'un par commande. Le dossier est créé par
  # install.sh — ssh ne le crée pas lui-même et échouerait en silence.
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 10m

  # Détecte une connexion morte en 3 min au lieu de laisser pendre le terminal.
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Debian active GSSAPI par défaut : une tentative d'authentification Kerberos
  # inutile ici, qui ne fait qu'allonger chaque poignée de main.
  GSSAPIAuthentication no
