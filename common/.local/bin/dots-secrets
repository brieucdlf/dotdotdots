#!/usr/bin/env bash
# dots-secrets — les secrets du poste, chiffrés dans le repo, la clé sur la YubiKey.
#
#   dots-secrets status            état de la chaîne (outils, token, destinataires, fichiers)
#   dots-secrets enroll            enrôle la YubiKey branchée comme destinataire
#   dots-secrets seal [nom...]     chiffre les fichiers en clair vers secrets/<nom>.age
#   dots-secrets unseal [nom...]   déchiffre secrets/<nom>.age vers leur destination
#   dots-secrets verify            prouve que la clé branchée ouvre les secrets
#   dots-secrets label <texte>     étiquette la clé branchée dans recipients.txt
#   dots-secrets edit <nom>        édite un secret sans jamais l'écrire sur un disque
#
# Le principe tient en une phrase : AUCUNE clé privée n'existe en dehors de la
# YubiKey. L'identité age est régénérée à la volée depuis le token à chaque
# déchiffrement — il n'y a donc rien à sauvegarder, rien à restaurer, et rien
# qui traîne dans ~ après un vol de machine. Cloner le repo et brancher la clé
# suffit à repeupler un poste neuf.
#
# Corollaire : un fichier .age n'est déchiffrable que par les YubiKeys listées
# dans secrets/recipients.txt AU MOMENT DU CHIFFREMENT. Enrôler une clé plus
# tard n'ouvre pas les fichiers déjà scellés — d'où le re-scellement automatique
# à la fin de `enroll`.

set -euo pipefail
umask 077

# Les binaires viennent de mise. Le script doit tourner depuis install.sh et
# depuis cron, où le shell n'a pas forcément été activé : on ajoute les shims
# nous-mêmes plutôt que de dépendre de l'environnement de l'appelant.
[[ -d $HOME/.local/share/mise/shims ]] && PATH="$HOME/.local/share/mise/shims:$PATH"

say()  { printf '\033[1;32m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" &>/dev/null; }

# ── racine du repo ───────────────────────────────────────────────────────────
# Le script est appelé via le lien ~/.local/bin/dots-secrets posé par stow :
# readlink -f nous ramène au fichier réel, donc au repo, où qu'il soit cloné.
self="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="${self%/common/.local/bin/dots-secrets}"
[[ $ROOT != "$self" && -d $ROOT/secrets ]] || \
  ROOT="$(git -C "$(dirname "$self")" rev-parse --show-toplevel 2>/dev/null || echo "$HOME/.dotfiles")"
[[ -d $ROOT/secrets ]] || die "racine du repo introuvable depuis $self"

MANIFEST="$ROOT/secrets/manifest"
RECIPIENTS="$ROOT/secrets/recipients.txt"

# ── zone de travail en mémoire ───────────────────────────────────────────────
# Tout ce qui est déchiffré transite par /dev/shm : un tmpfs, jamais écrit sur
# un bloc de disque, donc rien à effacer de façon sûre derrière nous. Le trap
# couvre aussi Ctrl-C et le kill, pas seulement la sortie normale.
TMP=""
cleanup() { [[ -n $TMP && -d $TMP ]] && rm -rf "$TMP"; return 0; }
trap cleanup EXIT INT TERM

mktmp() {
  [[ -n $TMP ]] && return 0
  local base=/dev/shm
  [[ -d $base && -w $base ]] || { base="${TMPDIR:-/tmp}"
    warn "/dev/shm indisponible — le clair transite par $base, sur disque"; }
  TMP="$(mktemp -d "$base/dots-secrets.XXXXXXXX")"
}

# ── manifeste ────────────────────────────────────────────────────────────────
rows() { grep -vE '^[[:space:]]*(#|$)' "$MANIFEST" || true; }
names() { rows | awk '{print $1}'; }
dest_of() { rows | awk -v n="$1" '$1 == n {print $2; exit}'; }
mode_of() { rows | awk -v n="$1" '$1 == n {print ($3 == "" ? "0600" : $3); exit}'; }

# Résout les noms passés en argument, ou tout le manifeste si aucun.
targets() {
  if [[ $# -eq 0 ]]; then names; return; fi
  local n
  for n in "$@"; do
    [[ -n "$(dest_of "$n")" ]] || die "inconnu au manifeste: $n (voir 'dots-secrets status')"
    echo "$n"
  done
}

require_age() {
  have age || die "age absent — lance 'mise install' dans le repo"
  have age-plugin-yubikey || die "age-plugin-yubikey absent — lance 'mise install'"
}

require_recipients() {
  [[ -s $RECIPIENTS ]] || \
    die "aucun destinataire enrôlé — branche la YubiKey puis 'dots-secrets enroll'"
}

# Identité de déchiffrement, dérivée du token branché. Rien n'est conservé :
# le fichier vit dans le tmpfs et meurt avec le script.
identity() {
  mktmp
  local f="$TMP/identity.txt"
  if [[ ! -s $f ]]; then
    age-plugin-yubikey --identity >"$f" 2>"$TMP/id.err" || {
      warn "$(cat "$TMP/id.err")"
      die "YubiKey illisible — branchée ? 'systemctl is-active pcscd' répond bien 'active' ?"
    }
    # Le plugin sort en 0 avec une sortie VIDE quand aucune clé n'est branchée :
    # l'absence de token et l'absence d'identité sont indiscernables ici. On ne
    # tranche donc pas, et surtout on ne conseille pas `enroll` — qui GÉNÉRERAIT
    # une identité de plus dans un slot PIV pour un simple oubli de branchement.
    grep -q 'AGE-PLUGIN-YUBIKEY' "$f" || die "aucune identité age visible.
   Branche une YubiKey enrôlée. Si elle l'est et que rien ne vient, vérifie
   'systemctl is-active pcscd.socket'."
  fi
  echo "$f"
}

recipient_list() { grep -oE 'age1yubikey1[0-9a-z]+' "$RECIPIENTS" 2>/dev/null || true; }

# Combien de destinataires un fichier chiffré connaît-il ? L'en-tête age est en
# CLAIR jusqu'à la ligne `---`, avec une strophe `-> ` par destinataire. C'est
# le seul moyen de vérifier qu'un .age est à jour sans pouvoir l'ouvrir — donc
# le seul qui marche quand on n'a en main que la clé fraîchement enrôlée.
stanza_count() { awk '/^---/{exit} /^-> /{n++} END{print n+0}' "$1"; }

# Les secrets qui ne couvrent pas encore tous les destinataires connus.
stale_secrets() {
  local want n src
  want="$(recipient_list | wc -l)"
  [[ $want -gt 0 ]] || return 0
  for n in $(names); do
    src="$ROOT/secrets/$n.age"
    [[ -f $src ]] || continue
    [[ "$(stanza_count "$src")" -lt "$want" ]] && echo "$n"
  done
  return 0
}

add_recipient() {
  local rcpt="$1" label="$2"
  mkdir -p "$ROOT/secrets"
  if recipient_list | grep -qx "$rcpt"; then
    say "déjà enrôlé, rien à faire : $label"
    return 1
  fi
  printf '# %s — enrôlée le %s\n%s\n' "$label" "$(date +%Y-%m-%d)" "$rcpt" >>"$RECIPIENTS"
  chmod 0644 "$RECIPIENTS"   # publique : ce sont des clés PUBLIQUES
  say "enrôlée : $label"
  return 0
}

# ── commandes ────────────────────────────────────────────────────────────────
cmd_enroll() {
  require_age
  local existing serial
  # Une YubiKey qui porte DÉJÀ une identité age (la deuxième clé, ou cette
  # machine réinstallée) est ajoutée telle quelle : en regénérer une écraserait
  # un slot PIV et rendrait illisibles les fichiers scellés pour l'ancienne.
  existing="$(age-plugin-yubikey --list 2>/dev/null | grep -oE 'age1yubikey1[0-9a-z]+' || true)"
  serial="$(age-plugin-yubikey --list 2>/dev/null | grep -oE 'Serial: [0-9]+' | head -1 || true)"

  local added=0
  if [[ -n $existing && ${1:-} != --new ]]; then
    say "identité age déjà présente sur le token — ajoutée sans rien regénérer"
    local r
    while read -r r; do
      add_recipient "$r" "YubiKey ${serial:-inconnue}" && added=1
    done <<<"$existing"
  else
    say "génération d'une identité age dans l'applet PIV"
    say "  PIN PIV demandé une fois par session, contact requis (mis en cache 15 s)"
    mktmp
    age-plugin-yubikey --generate \
      --touch-policy cached --pin-policy once \
      --name "dotfiles $(hostname -s 2>/dev/null || echo poste)" | tee "$TMP/gen.txt"
    local rcpt
    # `|| true` obligatoire : sous `set -o pipefail`, un grep sans résultat fait
    # échouer l'affectation, et `set -e` tue le script AVANT le die ci-dessous.
    # On perdrait le seul message qui explique quoi faire.
    rcpt="$(grep -oE 'age1yubikey1[0-9a-z]+' "$TMP/gen.txt" | head -1 || true)"
    [[ -n $rcpt ]] || die "destinataire illisible dans la sortie de --generate"
    # Le série n'existait pas avant la génération sur une clé vierge : on le
    # relit ici. Sans lui, deux clés donnent deux lignes identiques et plus
    # rien ne dit laquelle retirer si l'une est perdue.
    [[ -n $serial ]] || serial="$(grep -oE 'Serial: [0-9]+' "$TMP/gen.txt" | head -1 || true)"
    [[ -n $serial ]] || serial="$(age-plugin-yubikey --list 2>/dev/null | grep -oE 'Serial: [0-9]+' | head -1 || true)"
    add_recipient "$rcpt" "YubiKey ${serial:-série inconnue}" && added=1
  fi

  # Re-sceller : un .age n'ouvre que pour les destinataires présents AU
  # CHIFFREMENT. Sans ça, la clé fraîchement enrôlée serait un faux filet.
  #
  # On teste l'écart réel (en-têtes vs recipients.txt) et non « vient-on
  # d'ajouter quelqu'un ». La différence compte : enrôler B pendant que A est
  # débranchée écrit B dans recipients.txt puis échoue à re-sceller, faute de
  # clé capable de déchiffrer. Relancé avec A branchée, un enroll qui ne
  # regarderait que `added` répondrait « déjà enrôlé » et ne rattraperait
  # jamais rien — laissant un filet qui n'attrape pas.
  local stale; stale="$(stale_secrets)"
  if [[ -n $stale ]]; then
    say "secrets à re-sceller : $(echo $stale | tr '\n' ' ')"
    cmd_reseal
  elif [[ $added -eq 1 ]]; then
    say "aucun secret scellé pour l'instant — rien à re-sceller"
  fi
}

# Ouvre puis referme chaque secret avec la liste de destinataires à jour.
# Passe par le tmpfs : le clair ne touche jamais le disque ni sa destination.
cmd_reseal() {
  require_age; require_recipients
  local id n src; id="$(identity)"; mktmp
  for n in $(names); do
    src="$ROOT/secrets/$n.age"
    [[ -f $src ]] || continue
    age -d -i "$id" -o "$TMP/$n" "$src" || die "$n : le token branché ne peut pas l'ouvrir.
   Re-sceller exige une clé DÉJÀ destinataire. Branche les deux YubiKeys en
   même temps (age essaie toutes celles qu'il voit), ou rebranche l'ancienne
   puis relance 'dots-secrets reseal'. recipients.txt est déjà à jour :
   l'opération reprendra là où elle s'est arrêtée."
    age -R "$RECIPIENTS" -o "$src.new" "$TMP/$n"
    mv -f "$src.new" "$src"
    rm -f "$TMP/$n"
    say "re-scellé: $n"
  done
}

cmd_seal() {
  require_age; require_recipients
  local n dest list
  list="$(targets "$@")"
  for n in $list; do
    dest="$ROOT/$(dest_of "$n")"
    if [[ ! -f $dest ]]; then
      warn "$n : rien à chiffrer, ${dest#"$ROOT"/} n'existe pas"
      continue
    fi
    age -R "$RECIPIENTS" -o "$ROOT/secrets/$n.age" "$dest"
    say "scellé: $n  (${dest#"$ROOT"/})"
  done
}

cmd_unseal() {
  require_age
  local id n src dest list
  list="$(targets "$@")"; id="$(identity)"
  for n in $list; do
    src="$ROOT/secrets/$n.age"
    if [[ ! -f $src ]]; then
      warn "$n : pas encore scellé, rien à déchiffrer"
      continue
    fi
    dest="$ROOT/$(dest_of "$n")"
    mkdir -p "$(dirname "$dest")"
    # Écriture atomique : une interruption laisse l'ancien fichier intact
    # plutôt qu'un secret tronqué qui casserait le shell au prochain source.
    age -d -i "$id" -o "$dest.partial" "$src" || die "déchiffrement impossible: $n"
    chmod "$(mode_of "$n")" "$dest.partial"
    mv -f "$dest.partial" "$dest"
    say "déchiffré: ${dest#"$ROOT"/}"
  done
}

cmd_edit() {
  [[ $# -eq 1 ]] || die "usage: dots-secrets edit <nom>"
  require_age; require_recipients
  local n="$1" dest src f before after
  [[ -n "$(dest_of "$n")" ]] || die "inconnu au manifeste: $n"
  dest="$ROOT/$(dest_of "$n")"; src="$ROOT/secrets/$n.age"
  mktmp; f="$TMP/$n"

  if [[ -f $src ]]; then
    age -d -i "$(identity)" -o "$f" "$src"
  elif [[ -f $dest ]]; then
    cp "$dest" "$f"          # jamais scellé mais déjà en clair : on reprend
  elif [[ -f "$dest.sample" ]]; then
    cp "$dest.sample" "$f"   # premier jet : on part du modèle versionné
    say "parti de ${dest##*/}.sample"
  else
    : >"$f"
  fi

  before="$(sha256sum <"$f")"
  "${EDITOR:-nvim}" "$f"
  after="$(sha256sum <"$f")"
  [[ $before == "$after" ]] && { say "inchangé"; return 0; }

  age -R "$RECIPIENTS" -o "$src" "$f"
  mkdir -p "$(dirname "$dest")"
  install -m "$(mode_of "$n")" "$f" "$dest"
  say "scellé et déposé: $n"
}

# Prouve que la clé branchée ouvre vraiment les secrets. À lancer UNE FOIS PAR
# CLÉ, en les branchant tour à tour : une clé de secours jamais testée n'est pas
# une sauvegarde, c'est une supposition. Le canari couvre le cas « aucun secret
# scellé pour l'instant », où il n'y aurait rien d'autre à éprouver.
cmd_verify() {
  require_age; require_recipients
  mktmp
  local id mine line n src fails=0
  id="$(identity)"
  mine="$(age-plugin-yubikey --list 2>/dev/null | grep -oE 'age1yubikey1[0-9a-z]+' | head -1 || true)"

  if [[ -n $mine ]]; then
    if recipient_list | grep -qx "$mine"; then
      line="$(grep -B1 -x "$mine" "$RECIPIENTS" | head -1 | sed 's/^# *//')"
      say "clé branchée : ${line:-destinataire enrôlé}"
    else
      die "la clé branchée n'est PAS dans recipients.txt — elle n'ouvrira rien.
   C'est peut-être une troisième clé, ou une identité regénérée par-dessus
   l'ancienne (ce qui invaliderait la ligne correspondante)."
    fi
  fi

  printf 'canari dots-secrets\n' >"$TMP/canary"
  age -R "$RECIPIENTS" -o "$TMP/canary.age" "$TMP/canary"
  if age -d -i "$id" -o "$TMP/back" "$TMP/canary.age" 2>/dev/null \
     && cmp -s "$TMP/canary" "$TMP/back"; then
    say "canari chiffré pour les $(recipient_list | wc -l) destinataires : ouvert ✓"
  else
    warn "canari NON déchiffré par cette clé"; fails=1
  fi

  # Le canari valide la chaîne ; seuls les vrais fichiers valident la sauvegarde.
  local tested=0
  for n in $(names); do
    src="$ROOT/secrets/$n.age"
    [[ -f $src ]] || continue
    tested=1
    if age -d -i "$id" -o /dev/null "$src" 2>/dev/null; then
      say "$n : ouvert ✓"
    else
      warn "$n : NON ouvert par cette clé — 'dots-secrets reseal' avec une clé qui l'ouvre"
      fails=1
    fi
  done
  [[ $tested -eq 0 ]] && warn "aucun secret scellé pour l'instant : seul le canari a été éprouvé"

  [[ $fails -eq 0 ]] || die "cette clé n'ouvre pas tout — ne t'y fie pas comme secours"
  say "cette clé ouvre l'ensemble des secrets."
}

# Étiquette la clé BRANCHÉE dans recipients.txt. On ne devine pas d'après
# l'ordre d'enrôlement : on lit le destinataire que le token présente, et on
# annote cette ligne-là. Un mauvais label est pire que pas de label — il
# désignerait la mauvaise ligne à retirer le jour d'une perte.
cmd_label() {
  [[ $# -ge 1 ]] || die "usage: dots-secrets label <texte>   (ex: 'USB-C quotidien')"
  require_age; require_recipients
  local text="$*" mine
  mine="$(age-plugin-yubikey --list 2>/dev/null | grep -oE 'age1yubikey1[0-9a-z]+' | head -1 || true)"
  [[ -n $mine ]] || die "aucune clé lisible — branche celle que tu veux étiqueter"
  recipient_list | grep -qx "$mine" || \
    die "cette clé n'est pas dans recipients.txt — rien à étiqueter ('enroll' d'abord)"

  mktmp
  # La date d'enrôlement d'origine est conservée si elle figure dans l'ancien
  # commentaire : elle documente quand la clé est entrée dans le cercle.
  awk -v target="$mine" -v label="$text" '
    function flush() { if (pending != "") { print pending; pending = "" } }
    /^[[:space:]]*#/ { flush(); pending = $0; next }
    $0 == target {
      d = ""
      if (match(pending, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/))
        d = substr(pending, RSTART, RLENGTH)
      pending = ""
      print "# " label (d != "" ? " — enrôlée le " d : "")
      print
      next
    }
    { flush(); print }
    END { flush() }
  ' "$RECIPIENTS" >"$TMP/recipients.txt"

  grep -qx "$mine" "$TMP/recipients.txt" || die "réécriture incohérente, rien changé"
  [[ "$(grep -c . "$TMP/recipients.txt")" -ge "$(grep -c . "$RECIPIENTS")" ]] || \
    die "la réécriture perdrait des lignes, rien changé"
  cat "$TMP/recipients.txt" >"$RECIPIENTS"
  chmod 0644 "$RECIPIENTS"
  say "étiquetée : $text"
  sed -n 's/^# /   /p' "$RECIPIENTS"
}

cmd_status() {
  local ok="\033[1;32m✓\033[0m" ko="\033[1;31m✗\033[0m" mid="\033[1;33m~\033[0m"

  printf '\n\033[1moutils\033[0m\n'
  have age && printf "  $ok age %s\n" "$(age --version 2>/dev/null)" \
            || printf "  $ko age absent — 'mise install'\n"
  have age-plugin-yubikey && printf "  $ok %s\n" "$(age-plugin-yubikey --version 2>/dev/null)" \
            || printf "  $ko age-plugin-yubikey absent — 'mise install'\n"
  # install.sh active pcscd.socket, pas le service : le démon ne tourne qu'à la
  # demande et s'arrête ensuite. Interroger le service seul le montrait
  # « inactif » en régime normal — une fausse alerte permanente.
  if [[ "$(systemctl is-active pcscd.socket 2>/dev/null)" == active ]] \
  || [[ "$(systemctl is-active pcscd 2>/dev/null)" == active ]]; then
    printf "  $ok pcscd joignable (socket)\n"
  else
    printf "  $ko pcscd inactif — l'applet PIV est injoignable\n"
  fi

  printf '\n\033[1mtoken\033[0m\n'
  if have age-plugin-yubikey; then
    local ids; ids="$(age-plugin-yubikey --list 2>/dev/null | grep -oE 'age1yubikey1[0-9a-z]+' || true)"
    if [[ -n $ids ]]; then
      local known=0 i
      for i in $ids; do recipient_list | grep -qx "$i" && known=$((known + 1)); done
      printf "  $ok %s identité(s) age lisible(s), dont %s enrôlée(s)\n" \
        "$(wc -l <<<"$ids")" "$known"
      [[ $known -eq 0 ]] && \
        printf "  $mid cette clé n'est PAS destinataire — 'dots-secrets enroll'\n"
    else
      # Sortie vide = clé débranchée OU clé sans identité : le plugin ne les
      # distingue pas (code 0 dans les deux cas). On énonce les deux.
      printf "  $mid aucune identité age visible — clé débranchée, ou clé\n"
      printf "     jamais enrôlée ('dots-secrets enroll' une fois branchée)\n"
    fi
  else
    printf "  $ko age-plugin-yubikey absent\n"
  fi

  printf '\n\033[1mdestinataires\033[0m (secrets/recipients.txt)\n'
  local count; count="$(recipient_list | wc -l)"
  if [[ $count -eq 0 ]]; then
    printf "  $ko aucun — les secrets ne peuvent pas être chiffrés\n"
  else
    printf "  $ok %s clé(s) : chaque secret s'ouvre avec n'importe laquelle\n" "$count"
    [[ $count -eq 1 ]] && printf "  $mid une seule clé enrôlée : sa perte = secrets irrécupérables\n"
    sed -n 's/^# \(.*\)$/      \1/p' "$RECIPIENTS" 2>/dev/null
  fi

  printf '\n\033[1msecrets\033[0m\n'
  local n dest src state
  # Largeur calée sur le nom le plus long : un manifeste qui grossit ne casse
  # pas l'alignement de la colonne d'état. Plancher à 16 pour l'allure d'origine.
  local w=16
  for n in $(names); do
    if (( ${#n} > w )); then w=${#n}; fi
  done
  for n in $(names); do
    dest="$ROOT/$(dest_of "$n")"; src="$ROOT/secrets/$n.age"
    if [[ -f $src && -f $dest ]]; then   state="$ok scellé + déposé"
    elif [[ -f $src ]]; then             state="$mid scellé, pas déposé — 'unseal'"
    elif [[ -f $dest ]]; then            state="$ko EN CLAIR, jamais scellé — 'seal $n'"
    else                                 state="$mid absent — 'edit $n' pour le créer"
    fi
    printf "  %-${w}s $state\n" "$n"
  done

  # Un secret scellé pour moins de clés qu'il n'y a de destinataires est le
  # piège silencieux de cette chaîne : recipients.txt annonce un filet que les
  # fichiers n'ont pas. On le dit fort, à chaque status.
  local stale; stale="$(stale_secrets)"
  if [[ -n $stale ]]; then
    printf "\n  $ko à RE-SCELLER : %s\n" "$(echo $stale | tr '\n' ' ')"
    printf "     ces fichiers ne s'ouvrent pas avec toutes les clés enrôlées —\n"
    printf "     'dots-secrets reseal' avec une clé qui les ouvre déjà.\n"
  fi
  printf '\n'
}

case "${1:-status}" in
  status)  shift || true; cmd_status ;;
  enroll)  shift; cmd_enroll "$@" ;;
  seal)    shift; cmd_seal "$@" ;;
  unseal)  shift; cmd_unseal "$@" ;;
  reseal)  shift; cmd_reseal ;;
  verify)  shift; cmd_verify ;;
  label)   shift; cmd_label "$@" ;;
  edit)    shift; cmd_edit "$@" ;;
  -h|--help|help) sed -n '2,20p' "$self" | sed 's/^# \{0,1\}//' ;;
  *) die "commande inconnue: $1 (status|enroll|verify|label|seal|unseal|reseal|edit)" ;;
esac
