#!/bin/bash
# Greffe (ou retire) un bloc du dépôt dans la config de herdr.
#
#   dots-herdr-graft graft   theme <fichier-bloc> [accent]
#   dots-herdr-graft graft   keys  <fichier-bloc>
#   dots-herdr-graft ungraft theme
#   dots-herdr-graft ungraft keys
#
# herdr n'a pas d'include : sa configuration est un SEUL fichier, dont une part
# appartient à Omarchy (new_cwd, présentation, notifications, titre de fenêtre).
# D'où la greffe section par section plutôt qu'un remplacement de fichier.
#
# Deux blocs, deux paires de marqueurs, jamais mélangés :
#   theme → [theme], [theme.custom] et la ligne `accent` de [ui], rendu à chaque
#           changement de thème ;
#   keys  → [keys] et ses sous-tables, posé à l'install seulement.
# Chacun ne retire QUE ses propres sections, donc l'un peut être greffé sans
# l'autre, dans n'importe quel ordre, et un thème qui change ne touche pas aux
# raccourcis.
#
# Pourquoi un exécutable à part et pas du code dans le crochet theme-set : le
# crochet vit dans le paquet stow `omarchy` et n'est donc PAS posé sur Pop!_OS.
# Or .bashrc y préfère herdr dès qu'il est installé — herdr y tournait avec ses
# couleurs par défaut, et le herdr-theme.toml rendu à côté n'était lu par
# personne. Ce fichier est dans `common`, les deux machines l'ont, et
# install.sh l'appelle comme le crochet.
#
# Sorties : 0 fait, 1 refusé ou échoué, 2 pas de config herdr, 3 rien à dégreffer.
set -u

HERDR_CFG="${HERDR_CFG:-$HOME/.config/herdr/config.toml}"
HERDR_STOCK="${HERDR_STOCK:-${OMARCHY_PATH:-/usr/share/omarchy}/config/herdr/config.toml}"

THEME_BEGIN="# >>> dots theme — généré par theme/render.sh, ne pas éditer >>>"
THEME_END="# <<< dots theme <<<"
# `[.]` et non `\.` : la regex passe par `awk -v`, qui traite la chaîne
# comme une constante et prévient sur toute séquence d'échappement inconnue.
THEME_SECTIONS='^theme($|[.])'

KEYS_BEGIN="# >>> dots keys — greffé depuis herdr/keys.toml, ne pas éditer >>>"
KEYS_END="# <<< dots keys <<<"
# Les sous-tables comptent : `[[keys.command]]` d'Omarchy resterait orpheline
# derrière un [keys] retiré, à lier des touches qu'on croit avoir remplacées.
KEYS_SECTIONS='^keys($|[.])'

die() { printf 'dots-herdr-graft: %s\n' "$*" >&2; exit 1; }

# La valeur brute (guillemets compris) de `accent` dans [ui]. C'est une clé À
# PART de [theme] : elle colore les surbrillances, les bordures et la
# navigation, et Omarchy la met à "blue" pour imiter tmux.
ui_accent_of() {
  [[ -f $1 ]] || return 0
  awk '/^\[ui\]/ { u = 1; next }
       /^\[/     { u = 0 }
       u && /^accent[[:space:]]*=/ {
         sub(/^accent[[:space:]]*=[[:space:]]*/, ""); print; exit }' "$1"
}

# Les sections telles qu'Omarchy les livre : on ne devine pas ses valeurs pour
# dégreffer, on les lit dans le paquet.
stock_section_block() {
  [[ -f $HERDR_STOCK ]] || return 0
  awk -v re="$1" '
    function secname(l,   s) {
      s = l; sub(/\r$/, "", s); sub(/[[:space:]]*#.*$/, "", s)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      if (s !~ /^\[.*\]$/) return ""
      while (s ~ /^\[.*\]$/) {
        s = substr(s, 2, length(s) - 2)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      }
      return s
    }
    { sec = secname($0); if (sec != "") p = (sec ~ re) }
    p' "$HERDR_STOCK"
}

# herdr_write <rhs-accent> <fichier-bloc|""> <marqueurs 0|1> <début> <fin> <regex-sections>
herdr_write() {
  local acc="$1" block="$2" wrap="$3" begin="$4" end="$5" sections="$6" tmp
  [[ -f $HERDR_CFG ]] || return 0

  # [keys] sert de témoin, mais CONDITIONNELLEMENT : si elle était là avant,
  # elle doit être là après. L'exiger d'office bloquait à vie un utilisateur
  # sans [keys] — herdr rend toutes ses sections facultatives. Le témoin vaut
  # aussi pour la greffe des raccourcis, qui retire [keys] pour la réécrire :
  # un bloc source sans en-tête `[keys]` est refusé au lieu d'effacer les
  # raccourcis en place.
  local had_keys=0
  grep -q '^[[:space:]]*\[\[\?[[:space:]]*keys' "$HERDR_CFG" && had_keys=1

  tmp="$(mktemp)" || return 0
  trap 'rm -f "$tmp" "$tmp.trim"' RETURN

  # Les en-têtes sont reconnus par leur NOM, pas par une égalité de ligne :
  # `[theme] `, `[ theme ]` ou un fichier en CRLF passaient à travers, la
  # section n'était pas retirée, le bloc était ajouté quand même, et herdr
  # héritait de DEUX tables [theme] — TOML invalide, code de retour 0.
  awk -v b="$begin" -v e="$end" -v acc="$acc" -v re="$sections" '
    function secname(l,   s) {
      s = l; sub(/\r$/, "", s); sub(/[[:space:]]*#.*$/, "", s)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      # `while` et non `if` : [[keys.command]] est un tableau de tables, deux
      # paires de crochets, et il appartient à la section retirée.
      if (s !~ /^\[.*\]$/) return ""
      while (s ~ /^\[.*\]$/) {
        s = substr(s, 2, length(s) - 2)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      }
      return s
    }
    { line = $0; sub(/\r$/, "", line); sec = secname($0) }
    line == b          { skip = 1; next }
    line == e          { skip = 0; next }
    skip               { next }
    # La regex attrape aussi les sous-tables ([theme.custom.xxx],
    # [[keys.command]]), qui restaient orphelines derrière leur parent.
    sec ~ re           { drop = 1; next }
    sec == "ui"        { drop = 0; inui = 1; print
                         if (acc != "") print "accent = " acc
                         next }
    sec != ""          { drop = 0; inui = 0 }
    # On ne retire la ligne que si on en remet une : sinon un accent vide
    # SUPPRIMAIT le réglage en place sans rien mettre à sa place.
    inui && acc != "" && line ~ /^accent[[:space:]]*=/ { next }
    drop               { next }
                       { print }
  ' "$HERDR_CFG" >"$tmp" || return 1

  [[ -s $tmp ]] || return 1

  # Un bloc vide en dégreffage retirerait la section sans rien remettre.
  [[ -n $block && ! -s $block ]] && return 1

  if [[ -n $block && -f $block ]]; then
    # Lignes vides de fin retirées avant l'ajout : sinon le saut posé devant le
    # bloc s'empile sur celui que la section retirée laisse derrière elle.
    printf '%s\n' "$(cat "$tmp")" >"$tmp.trim" && mv -f "$tmp.trim" "$tmp"
    if [[ $wrap == 1 ]]; then
      { printf '%s\n' "$begin"; cat "$block"; printf '%s\n' "$end"; } >>"$tmp" || return 1
    else
      { printf '\n'; cat "$block"; } >>"$tmp" || return 1
    fi
  fi

  # Témoin vérifié APRÈS l'ajout du bloc, sinon la greffe des raccourcis —
  # qui retire [keys] avant de la réécrire — échouerait sur son propre passage.
  if (( had_keys )); then grep -q '^[[:space:]]*\[\[\?[[:space:]]*keys' "$tmp" || return 1; fi

  # `cat >` et non `mv` : le fichier garde son inode et ses droits. En échange
  # `>` tronque AVANT d'écrire, d'où la copie — le reste du fichier vient
  # d'Omarchy et rien ici ne le régénère.
  local backed=0
  cp -p "$HERDR_CFG" "$HERDR_CFG.dots-bak" && backed=1
  if ! cat "$tmp" >"$HERDR_CFG"; then
    # Uniquement la copie de CE passage : un .dots-bak d'une fois d'avant
    # remettrait une config périmée, pire que ne rien faire.
    (( backed )) && cat "$HERDR_CFG.dots-bak" >"$HERDR_CFG"
    return 1
  fi
  (( backed )) && rm -f "$HERDR_CFG.dots-bak"
  command -v herdr >/dev/null && herdr server reload-config >/dev/null 2>&1
  return 0
}

usage() {
  printf 'usage: dots-herdr-graft graft theme <fichier-bloc> [accent]\n'
  printf '       dots-herdr-graft graft keys <fichier-bloc>\n'
  printf '       dots-herdr-graft ungraft theme|keys\n'
  exit 1
}

case "${1:-}:${2:-}" in
  graft:theme)
    block="${3:-}"; accent="${4:-}"
    [[ -n $block ]] || die "graft theme attend un fichier de bloc"
    [[ -f $HERDR_CFG ]] || exit 2
    [[ -f $block ]] || die "bloc introuvable : $block"
    acc=""
    [[ -n $accent ]] && acc="\"$accent\""
    herdr_write "$acc" "$block" 1 "$THEME_BEGIN" "$THEME_END" "$THEME_SECTIONS" ||
      die "greffe refusée, config laissée telle quelle"
    ;;
  graft:keys)
    block="${3:-}"
    [[ -n $block ]] || die "graft keys attend un fichier de bloc"
    [[ -f $HERDR_CFG ]] || exit 2
    [[ -f $block ]] || die "bloc introuvable : $block"
    # Pas d'accent ici : il appartient au thème, et le passer vide laisserait
    # la ligne d'[ui] en place — c'est exactement ce qu'on veut.
    herdr_write "" "$block" 1 "$KEYS_BEGIN" "$KEYS_END" "$KEYS_SECTIONS" ||
      die "greffe des raccourcis refusée, config laissée telle quelle"
    ;;
  ungraft:theme|ungraft:keys)
    what="$2"
    [[ -f $HERDR_CFG ]] || exit 2
    if [[ $what == theme ]]; then
      begin="$THEME_BEGIN"; end="$THEME_END"; sections="$THEME_SECTIONS"
    else
      begin="$KEYS_BEGIN"; end="$KEYS_END"; sections="$KEYS_SECTIONS"
    fi
    grep -qF "$begin" "$HERDR_CFG" || exit 3   # rien de greffé
    # Sans le fichier livré par Omarchy on ne SAIT PAS quoi remettre : retirer
    # la section sans rien à sa place est pire que de laisser une greffe
    # complète mais inadaptée.
    [[ -f $HERDR_STOCK ]] || die "config d'origine introuvable : $HERDR_STOCK"
    stock="$(mktemp)" || exit 1
    trap 'rm -f "$stock"' EXIT
    trap 'exit 130' HUP INT TERM
    stock_section_block "$sections" >"$stock"
    [[ -s $stock ]] || die "aucune section correspondante dans $HERDR_STOCK"
    acc=""
    [[ $what == theme ]] && acc="$(ui_accent_of "$HERDR_STOCK")"
    herdr_write "$acc" "$stock" 0 "$begin" "$end" "$sections" ||
      die "dégreffage refusé, config laissée telle quelle"
    ;;
  *) usage ;;
esac
