#!/usr/bin/env python3
"""Panneau latéral Claude Code — agents en cours, quota, conso.

En python3 et non en bash comme le reste de bin/ : le gros du travail est du
parsing de JSONL incrémental avec cache, ce que bash ne fait pas sans un jq par
ligne. La règle du repo qui tient toujours : aucune couleur codée en dur, tout
vient de ~/.config/theme/current/palette.sh, généré par theme/render.sh.

Deux rendus selon la largeur du pane : complet à partir de 14 colonnes, replié
en dessous (icônes d'état empilées + quota). C'est tmux-claude-panel qui
redimensionne, le script ne fait que s'adapter.

Le pane est interactif quand il a le focus : j/k ou ↑/↓ pour parcourir les
agents, Entrée ou clic pour sauter sur sa fenêtre tmux, q pour fermer.

    claude-panel             boucle, rafraîchit toutes les 5 s (usage tmux)
    claude-panel --once      un seul rendu puis sortie
    claude-panel -i 10       autre intervalle
    claude-panel --width 5   forcer une largeur (mise au point)
    claude-panel --cli       forcer la lecture via `claude agents --json`
"""

import json
import os
import re
import select
import signal
import subprocess
import sys
import termios
import time
import tty
from datetime import datetime, timedelta
from pathlib import Path

HOME = Path.home()
CLAUDE = HOME / ".claude"
CACHE = HOME / ".cache" / "claude-panel"
USAGE_CACHE = CACHE / "usage.json"
RATE_CACHE = CACHE / "rate-limits.json"
SESSION_CACHE = CACHE / "sessions"
SESSION_TTL = 3 * 86400     # au-delà, la session n'existe plus : on purge

COMPACT_UNDER = 14          # en dessous, rendu replié
DEFAULT_WIDTH = 44          # hors tmux ou si la largeur est illisible
RETENTION_DAYS = 8

# $ par million de tokens. Multiplicateurs de cache de l'API : lecture 0.1x le
# prix d'entrée, écriture 1.25x en TTL 5 min et 2x en TTL 1 h.
PRICING = {
    "fable-5": (10.0, 50.0),
    "mythos-5": (10.0, 50.0),
    "opus-5": (5.0, 25.0),
    "opus-4-8": (5.0, 25.0),
    "opus-4-7": (5.0, 25.0),
    "opus-4-6": (5.0, 25.0),
    "sonnet-5": (3.0, 15.0),   # tarif d'intro 2/10 jusqu'au 31/08/2026
    "sonnet-4-6": (3.0, 15.0),
    "haiku-4-5": (1.0, 5.0),
}
CACHE_READ, CACHE_W5M, CACHE_W1H = 0.1, 1.25, 2.0

# États qu'un agent background ne conserve qu'en historique : `claude agents`
# sans --all ne les liste pas, on fait pareil.
FINISHED = {"done", "failed", "stopped"}


# ── couleurs ────────────────────────────────────────────────────────────────
def load_palette():
    pal, path = {}, HOME / ".config/theme/current/palette.sh"
    try:
        for m in re.finditer(r'export (THEME_\w+)="([^"]*)"', path.read_text()):
            pal[m.group(1)] = m.group(2)
    except OSError:
        pass
    return pal


PAL = load_palette()


def fg(key, fallback="#ffffff"):
    """#rrggbb -> séquence ANSI truecolor. Clé absente = repli neutre."""
    h = PAL.get(key, fallback).lstrip("#")
    if len(h) != 6:
        h = fallback.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
    return f"\033[38;2;{r};{g};{b}m"


RESET, BOLD = "\033[0m", "\033[1m"
C_TITLE = fg("THEME_ACCENT")
C_TEXT = fg("THEME_FOREGROUND")
C_DIM = fg("THEME_COLOR13")
C_MUTED = fg("THEME_COLOR5")
C_OK = fg("THEME_COLOR10")
C_WARN = fg("THEME_COLOR11")
C_ALERT = fg("THEME_COLOR9")
C_INFO = fg("THEME_COLOR14")
C_RULE = fg("THEME_BORDER_INACTIVE")


def section(title, width, right=""):
    """[titre prolongé par un filet, ligne vide].

    Sépare franchement sans coûter une ligne de hauteur, et laisse le compteur
    calé à droite. Le filet prend le gris de bordure du thème, pas une couleur
    inventée.
    """
    tail = f"  {right}" if right else ""
    # -1 : écrire jusqu'à la dernière colonne provoque un retour à la ligne
    # différé sur certains terminaux, et une ligne vide parasite au rendu.
    rule = max(0, width - (2 + len(title)) - len(tail) - 1)
    # La ligne vide fait partie de l'en-tête : le titre respire au lieu de
    # coller à son contenu, et aucun appelant ne peut l'oublier.
    return [f" {C_TITLE}{BOLD}{title}{RESET} {C_RULE}{'─' * rule}{RESET}"
            + (f"  {C_DIM}{right}{RESET}" if right else ""), ""]


def tint(pct):
    return C_OK if pct < 50 else (C_WARN if pct < 80 else C_ALERT)


# ── mise en forme ───────────────────────────────────────────────────────────
def human_tokens(n):
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.0f}k"
    return str(n)


def human_age(started_ms):
    if not started_ms:
        return ""
    s = max(0, time.time() - started_ms / 1000)
    if s < 60:
        return f"{int(s)}s"
    if s < 3600:
        return f"{int(s // 60)}m"
    if s < 86400:
        return f"{int(s // 3600)}h"
    return f"{int(s // 86400)}j"


def bar(pct, width=10):
    filled = min(width, round(pct / 100 * width))
    # Une part non nulle mérite au moins un bloc : sans ça 2 % et 0 % donnent
    # la même barre vide, et le classement ne veut plus rien dire.
    if pct > 0:
        filled = max(1, filled)
    return "█" * max(0, filled) + "░" * (width - max(0, filled))


def visible_len(s):
    return len(re.sub(r"\033\[[0-9;]*m", "", s))


def pad(s, width):
    return s + " " * max(0, width - visible_len(s))


def trunc(s, width):
    return s if len(s) <= width else s[: max(0, width - 1)] + "…"


def iso_ms(value):
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp() * 1000
    except (AttributeError, ValueError):
        return None


# ── agents ──────────────────────────────────────────────────────────────────
def read_agents_disk():
    """Lecture directe de ~/.claude/{sessions,jobs}/.

    `claude agents --json` est l'interface documentée, mais elle coûte ~270 ms
    par appel (démarrage d'un runtime node) pour des données déjà posées sur le
    disque — inacceptable dans un pane qui se rafraîchit toutes les 5 s. Les
    fichiers donnent en prime le `detail`/`needs` de chaque agent background,
    que la sortie JSON de la CLI ne porte pas.

    Les deux dossiers SE RECOUVRENT : dès qu'on attache un agent background, il
    gagne un fichier de session tout en gardant son état de job. Sans
    déduplication par sessionId il apparaît deux fois, et la ligne background —
    qui n'a pas d'emplacement tmux — relance un `claude attach` à chaque
    Entrée. D'où l'impression que sélectionner un agent le duplique.

    Retourne None si l'arborescence n'est pas celle attendue : l'appelant
    repasse alors par la CLI plutôt que d'afficher un panneau vide et mensonger.
    """
    if not (CLAUDE / "sessions").is_dir():
        return None

    by_id, loose = {}, []

    # Les jobs d'abord : la session vivante, plus récente, complètera.
    for state_file in (CLAUDE / "jobs").glob("*/state.json"):
        try:
            d = json.loads(state_file.read_text())
        except (OSError, ValueError):
            continue
        if d.get("state") in FINISHED:
            continue
        entry = {
            "kind": "background", "id": state_file.parent.name, "cwd": d.get("cwd"),
            "name": d.get("name"), "sessionId": d.get("sessionId"),
            "state": d.get("state"), "startedAt": iso_ms(d.get("createdAt")),
            "since": iso_ms(d.get("updatedAt")),
            "detail": (d.get("needs") or d.get("detail") or "").strip(),
        }
        if entry["sessionId"]:
            by_id[entry["sessionId"]] = entry
        else:
            loose.append(entry)

    for f in (CLAUDE / "sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        pid = d.get("pid")
        if not pid:
            continue
        try:
            os.kill(int(pid), 0)          # session morte = fichier resté là
        except (OSError, ValueError):
            continue
        sid = d.get("sessionId")
        live = {
            "kind": "interactive", "pid": pid, "cwd": d.get("cwd"),
            "name": d.get("name"), "sessionId": sid,
            "startedAt": d.get("startedAt"), "status": d.get("status"),
            "since": d.get("statusUpdatedAt"),   # début du tour en cours
            "tmux": d.get("tmux"),          # « session:@fenêtre.%pane »
        }
        if sid and sid in by_id:
            # Agent background attaché : il redevient une session interactive
            # (c'est son état vivant qui fait foi), mais on garde son id court
            # pour `claude attach/stop` et son detail s'il reste bloqué.
            merged = by_id[sid]
            merged.pop("state", None)
            merged.update({k: v for k, v in live.items() if v is not None})
            merged["kind"] = "interactive"
        elif sid:
            by_id[sid] = live
        else:
            loose.append(live)

    return list(by_id.values()) + loose


def read_agents_cli():
    try:
        r = subprocess.run(["claude", "agents", "--json"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return json.loads(r.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return None


def read_agents(force_cli=False):
    if not force_cli:
        disk = read_agents_disk()
        if disk is not None:
            return disk, None
    cli = read_agents_cli()
    if cli is not None:
        return cli, "via CLI"
    return [], "source muette"


_OWN_WINDOW = ""


def own_window():
    """Fenêtre tmux qui héberge CE panneau — sert à repérer « l'agent d'ici »
    et à se refermer quand il n'y en a plus."""
    global _OWN_WINDOW
    if _OWN_WINDOW == "":
        pane = os.environ.get("TMUX_PANE")
        _OWN_WINDOW = (tmux("display-message", "-p", "-t", pane, "#{window_id}")
                       if pane else None) or None
    return _OWN_WINDOW


def agent_window(a):
    loc = a.get("tmux") or ""
    if ":" in loc and "." in loc:
        return loc.split(":", 1)[1].partition(".")[0]
    # Pas d'emplacement enregistré (agent lancé par `claude attach`) : on le
    # cherche par son pid. Rare, donc on ne paie l'appel tmux que là.
    found = pane_of_pid(a.get("pid")) if a.get("pid") else None
    return found[0] if found else None


META_STALE = 900            # au-delà, les chiffres décrivent un passé lointain


def session_meta(sid):
    """(méta, périmée) — déposées par la statusline. Le coût, le contexte et le
    numéro de PR ne sont connus que du client, aucun fichier de session ne les
    porte.

    La statusline n'écrit que lorsqu'une session rafraîchit sa ligne : une
    session endormie depuis une heure a des chiffres figés. On les rend, mais
    marqués, plutôt que de les afficher comme frais.
    """
    if not sid:
        return {}, False
    path = SESSION_CACHE / f"{sid}.json"
    try:
        age = time.time() - path.stat().st_mtime
        if age > SESSION_TTL:
            path.unlink(missing_ok=True)
            return {}, False
        return json.loads(path.read_text()), age > META_STALE
    except (OSError, ValueError):
        return {}, False


_BRANCHES = {}


def branch_of(cwd):
    """Branche git du dossier d'un agent, mémorisée 30 s.

    Appelée seulement pour les agents détaillés (courant, sélectionné), donc
    un ou deux `git` par rafraîchissement au pire.
    """
    if not cwd:
        return ""
    hit = _BRANCHES.get(cwd)
    if hit and hit[0] > time.time():
        return hit[1]
    name = ""
    try:
        r = subprocess.run(["git", "-C", cwd, "branch", "--show-current"],
                           capture_output=True, text=True, timeout=2)
        if r.returncode == 0:
            name = r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    _BRANCHES[cwd] = (time.time() + 30, name)
    return name


STATE_STYLE = {
    "blocked": ("✻", C_WARN, "bloqué"),
    "working": ("✽", C_INFO, ""),
    "busy": ("✽", C_INFO, ""),
    "idle": ("∙", C_MUTED, ""),
    "done": ("✓", C_OK, "fini"),
    "failed": ("✗", C_ALERT, "échec"),
    "stopped": ("⏹", C_MUTED, "arrêté"),
}
STATE_ORDER = {"blocked": 0, "working": 1, "busy": 1, "idle": 2,
               "failed": 3, "done": 4, "stopped": 5}
WORKING = ("working", "busy")
# Braille : tous les motifs ont le même encombrement, donc ça tourne au lieu de
# battre. Les glyphes ✳/✽/✻ n'ont pas la même graisse — animés, ils donnaient
# une icône qui grossit et rétrécit.
SPINNER = ("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")
SPIN_PERIOD = 0.12          # une image toutes les 120 ms
TICK = 0


def is_working(a):
    return agent_state(a) in WORKING


def agent_state(a):
    return a.get("state") or a.get("status") or "idle"


def sorted_agents(force_cli=False):
    agents, note = read_agents(force_cli)
    agents.sort(key=lambda a: (STATE_ORDER.get(agent_state(a), 9),
                               -(a.get("startedAt") or 0)))
    return agents, note


def render_agents(agents, note, width, selected, current):
    """Retourne (lignes, {index de ligne: index d'agent}).

    La table de correspondance sert au clic : sans elle, impossible de savoir
    quel agent occupe la ligne cliquée.
    """
    lines, rows, cells = section("AGENTS", width, str(len(agents))), {}, []
    if not agents:
        lines.append(f"   {C_MUTED}aucune session{RESET}")
        return lines, rows, cells
    if note:
        lines.append(f"   {C_MUTED}{note}{RESET}")

    for i, a in enumerate(agents):
        st = agent_state(a)
        icon, color, label = STATE_STYLE.get(st, ("·", C_MUTED, st))
        # Pas de colonne projet : Claude dérive le nom de session du dossier
        # (mon-projet-a1, autre-projet-b2…), l'afficher en plus ne ferait
        # que voler la place au nom.
        name = a.get("name") or Path(a.get("cwd") or "").name \
            or (a.get("sessionId") or "?")[:8]
        # Processus mort mais session encore attachable : la vue agents native
        # distingue les deux par la forme de l'icône, on garde l'idée.
        if a.get("kind") == "background" and not a.get("pid"):
            icon = "∘"
        busy = is_working(a)
        meta, stale = session_meta(a.get("sessionId"))
        if busy:
            icon = SPINNER[TICK % len(SPINNER)]
        # Toujours le temps écoulé depuis le dernier CHANGEMENT D'ÉTAT, jamais
        # l'âge de la session : « travaille depuis 2m » et « inactif depuis 3h »
        # se décident, « démarré il y a 4h » n'apprend rien.
        dur = human_age(a.get("since") or a.get("startedAt"))
        segments = []
        ctx = meta.get("ctx")
        if ctx is not None and not label:
            # Une session à 85 % va compacter et perdre son historique sans
            # prévenir : c'est le chiffre qui mérite d'être scannable.
            segments.append((f"{int(ctx)}%", C_MUTED if stale else tint(int(ctx))))
        segments.append((dur, C_TITLE if busy else C_DIM))
        if label:
            segments.append((label, C_WARN))
        right_raw = "  ".join(t for t, _ in segments)
        right = "  ".join(f"{c}{t}{RESET}" for t, c in segments)
        sel = a.get("sessionId") and a.get("sessionId") == selected
        here = current and a.get("sessionId") == current
        avail = max(8, width - len(right_raw) - 8)
        # Deux signaux sur deux éléments distincts : l'agent d'ici porte
        # l'accent sur son NOM, celui qui travaille anime son ICÔNE. Les cumuler
        # sur le même élément les rendrait indistinguables.
        icon_style = f"{BOLD}{C_TITLE}" if busy else color
        name_style = (f"{BOLD}{C_TITLE}" if here
                      else (f"{BOLD}{color}" if (sel or busy) else color))
        head = (f"{color} {'▸' if sel else ' '} {icon_style}{icon}{RESET} "
                f"{name_style}{trunc(name, avail)}{RESET}")
        rows[len(lines)] = i
        if busy:
            # Colonne visible de l'icône dans « ␣▸␣✽ » : la 4e (base 1).
            cells.append((len(lines) + 1, 4))
        lines.append(f"{pad(head, width - len(right_raw) - 2)}{right} ")
        # Détail pour l'agent d'ici ET pour celui qu'on pointe : deux lignes
        # courtes plutôt qu'une longue tronquée — une branche tronquée devient
        # trompeuse.
        if here or sel:
            tone = C_MUTED if stale else C_INFO
            # « Opus 5 (1M context) » : la parenthèse ne dit rien qu'on ne sache.
            bits = [(meta.get("model") or "").split(" (")[0], meta.get("effort")]
            if meta.get("cost"):
                bits.append(f"~{meta['cost']:.2f} $")
            if stale:
                bits.append("périmé")
            bits = [b for b in bits if b]
            if bits:
                rows[len(lines)] = i
                lines.append(f"     {tone}{trunc(' · '.join(bits), width - 6)}{RESET}")
            elif here:
                rows[len(lines)] = i
                lines.append(f"     {C_MUTED}en attente de la statusline{RESET}")

            loc = [b for b in (branch_of(a.get("cwd")),
                               f"#{meta['pr']}" if meta.get("pr") else "") if b]
            if loc:
                rows[len(lines)] = i
                lines.append(f"     {C_MUTED}{trunc(' · '.join(loc), width - 6)}{RESET}")
        # « bloqué » tout seul ne dit pas ce qu'on attend de toi. Le détail
        # n'est affiché que là, et seulement là : ailleurs il ferait du bruit.
        if st == "blocked" and a.get("detail"):
            rows[len(lines)] = i          # cliquer le détail vise le même agent
            lines.append(f"      {C_MUTED}{trunc(a['detail'], width - 8)}{RESET}")
    return lines, rows, cells


# ── quota (écrit par la statusline) ─────────────────────────────────────────
def read_quota():
    try:
        d = json.loads(RATE_CACHE.read_text())
    except (OSError, ValueError):
        return None, False
    return (d.get("rate_limits") or {}), (time.time() - d.get("at", 0) > 600)


def render_quota(width):
    rl, stale = read_quota()
    if rl is None:
        return section("QUOTA", width) + [
            f"   {C_MUTED}en attente d'une session Claude{RESET}"]

    # Un quota figé affiché comme s'il était frais est pire que pas de quota
    # du tout : la statusline n'a plus tourné depuis 10 min.
    header = section("QUOTA", width, "périmé" if stale else "")
    lines = list(header)

    for key, label in (("five_hour", "5 h"), ("seven_day", "7 j")):
        w = rl.get(key) or {}
        if w.get("used_percentage") is None:
            continue
        pct = int(w["used_percentage"])
        color = C_MUTED if stale else tint(pct)
        resets = ""
        if w.get("resets_at"):
            left = w["resets_at"] - time.time()
            if left > 0:
                h, m = int(left // 3600), int((left % 3600) // 60)
                if h >= 24:                       # « ↻ 78h57 » ne se lit pas
                    resets = f"↻ {h // 24}j{h % 24:02d}h"
                elif h:
                    resets = f"↻ {h}h{m:02d}"
                else:
                    resets = f"↻ {m}m"
        lines.append(
            f"   {C_TEXT}{label}{RESET}   {color}{bar(pct, 16)}{RESET}"
            f"   {color}{pct:>3}%{RESET}   {C_DIM}{resets}{RESET}"
        )
    if len(lines) == len(header):   # aucune fenêtre de quota rapportée
        lines.append(f"   {C_MUTED}aucun quota rapporté{RESET}")
    return lines


# ── conso (transcripts) ─────────────────────────────────────────────────────
def price(model):
    """(in, out) en $/MTok, ou None si le modèle est inconnu — on compte alors
    les tokens sans inventer un tarif."""
    m = (model or "").removeprefix("claude-")
    for key, val in PRICING.items():
        if m.startswith(key):
            return val
    return None


def load_cache():
    try:
        d = json.loads(USAGE_CACHE.read_text())
        if d.get("version") == 3:
            # Les clés de dédup sont sérialisées en liste mais interrogées des
            # milliers de fois par passage : en set, la recherche est en O(1).
            d["seen"] = {k: set(v) for k, v in d["seen"].items()}
            return d
    except (OSError, ValueError, AttributeError):
        pass
    # Schéma inconnu ou périmé : on repart de zéro plutôt que de mélanger deux
    # formes. Le cache se reconstruit en une passe sur les 8 derniers jours.
    return {"version": 3, "cursors": {}, "hours": {}, "seen": {}, "names": {}}


def scan_usage():
    """Agrège les usages des transcripts. Incrémental : un curseur d'octets par
    fichier, seuls les fichiers qui ont grandi sont relus. Sans ça, 169 Mo de
    JSONL seraient reparcourus à chaque rafraîchissement.

    Les seaux sont heure × projet × modèle. Le modèle vient de CHAQUE message,
    pas de la session : changer de modèle en cours de route est donc attribué
    correctement, à la réponse près.
    """
    cache = load_cache()
    cursors, hours, seen = cache["cursors"], cache["hours"], cache["seen"]
    names = cache.setdefault("names", {})
    cutoff = datetime.now() - timedelta(days=RETENTION_DAYS)
    dirty = False

    for path in (CLAUDE / "projects").glob("*/*.jsonl"):
        key, project = str(path), path.parent.name
        try:
            stat = path.stat()
        except OSError:
            continue
        if datetime.fromtimestamp(stat.st_mtime) < cutoff:
            dirty |= cursors.pop(key, None) is not None
            continue
        start = cursors.get(key, 0)
        if start > stat.st_size:      # fichier tronqué ou remplacé
            start = 0
        if start == stat.st_size:
            continue
        try:
            with path.open("rb") as fh:
                fh.seek(start)
                blob = fh.read()
                cursors[key] = fh.tell()
        except OSError:
            continue
        dirty = True

        # Une ligne coupée en fin de lecture serait du JSON invalide : on la
        # laisse pour le prochain passage en reculant le curseur d'autant.
        if blob and not blob.endswith(b"\n"):
            tail = blob.rfind(b"\n")
            if tail == -1:
                cursors[key] = start
                continue
            cursors[key] = start + tail + 1
            blob = blob[: tail + 1]

        for raw in blob.split(b"\n"):
            if not raw.strip():
                continue
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            # Le dossier de projet est un chemin encodé dont on ne peut pas
            # redéduire le nom (les tirets du chemin et ceux des dossiers se
            # confondent) : on prend le cwd, que chaque entrée porte.
            if e.get("cwd") and project not in names:
                names[project] = Path(e["cwd"]).name or project
            msg = e.get("message") or {}
            usage = msg.get("usage")
            if not usage:
                continue
            try:
                when = datetime.fromisoformat(
                    (e.get("timestamp") or "").replace("Z", "+00:00")).astimezone()
            except ValueError:
                continue
            if when.replace(tzinfo=None) < cutoff:
                continue
            day = when.strftime("%Y-%m-%d")
            # Dédup : une même réponse est réécrite dans un autre transcript à
            # la reprise ou au fork d'une session, et compterait deux fois.
            uid = f"{msg.get('id') or e.get('uuid')}:{e.get('requestId') or ''}"
            bucket = seen.setdefault(day, set())
            if uid in bucket:
                continue
            bucket.add(uid)

            cc = usage.get("cache_creation") or {}
            w5 = cc.get("ephemeral_5m_input_tokens", 0)
            w1h = cc.get("ephemeral_1h_input_tokens", 0)
            if not (w5 or w1h):
                w5 = usage.get("cache_creation_input_tokens", 0)
            slot = (hours.setdefault(when.strftime("%Y-%m-%dT%H"), {})
                         .setdefault(project, {})
                         .setdefault(msg.get("model") or "?", [0, 0, 0, 0, 0, 0]))
            slot[0] += usage.get("input_tokens", 0)
            slot[1] += usage.get("output_tokens", 0)
            slot[2] += w5
            slot[3] += w1h
            slot[4] += usage.get("cache_read_input_tokens", 0)
            slot[5] += 1                    # une réponse = un tour facturé

    keep = cutoff.strftime("%Y-%m-%d")
    for h in [h for h in hours if h[:10] < keep]:
        del hours[h]
        dirty = True
    for d in [d for d in seen if d < keep]:
        del seen[d]
        dirty = True

    if dirty:                          # rien n'a bougé = rien à réécrire
        try:
            CACHE.mkdir(parents=True, exist_ok=True)
            tmp = USAGE_CACHE.with_suffix(".tmp")
            tmp.write_text(json.dumps(
                {**cache, "seen": {k: sorted(v) for k, v in seen.items()}}))
            tmp.replace(USAGE_CACHE)
        except OSError:
            pass
    return hours, names


# Libellés des postes de coût, du plus cher au moins cher dans l'usage courant.
KINDS = ("lecture", "cache 1h", "sortie", "cache 5m", "entrée")


def totals(hours, since_hour):
    """Coût et ventilations sur la fenêtre demandée.

    Les ventilations sont en COÛT et non en tokens : 98 % des tokens sont de la
    lecture de cache, qui ne pèse que 64 % de la note. Classer par volume
    désignerait le mauvais coupable.
    """
    cost, out_tokens, turns = 0.0, 0, 0
    by_project, by_model = {}, {}
    by_kind = dict.fromkeys(KINDS, 0.0)

    for hkey, projects in hours.items():
        if hkey < since_hour:
            continue
        for project, models in projects.items():
            for model, (i, o, w5, w1h, cr, n) in models.items():
                out_tokens += o
                turns += n
                p = price(model)
                if not p:            # modèle inconnu : compté, mais pas chiffré
                    continue
                pin, pout = p
                parts = {
                    "entrée": i * pin,
                    "sortie": o * pout,
                    "cache 5m": w5 * pin * CACHE_W5M,
                    "cache 1h": w1h * pin * CACHE_W1H,
                    "lecture": cr * pin * CACHE_READ,
                }
                total = sum(parts.values()) / 1_000_000
                cost += total
                for k, v in parts.items():
                    by_kind[k] += v / 1_000_000
                by_project[project] = by_project.get(project, 0.0) + total
                by_model[model] = by_model.get(model, 0.0) + total
    return cost, out_tokens, turns, by_project, by_model, by_kind


def ranked(share, names=None, top=3):
    """Les `top` postes les plus chers, en (libellé, part en %)."""
    total = sum(share.values())
    if total <= 0:
        return []
    items = sorted(share.items(), key=lambda kv: -kv[1])[:top]
    return [((names or {}).get(k, k), v / total * 100) for k, v in items if v > 0]


def render_usage(scan, width):
    hours, names = scan
    now = datetime.now()
    today_cost, today_out, today_turns, *_ = totals(hours, now.strftime("%Y-%m-%dT00"))
    week = (now - timedelta(days=7)).strftime("%Y-%m-%dT%H")
    week_cost, week_out, _, by_project, by_model, by_kind = totals(hours, week)

    lines = section("CONSO", width)
    # « ici » n'est pas décoratif : les transcripts d'une autre machine et les
    # sessions web ne laissent aucune trace locale. Aujourd'hui est complet,
    # la semaine ne l'est pas, et comparer les deux sans le savoir induit en
    # erreur.
    for label, c, o in (("aujourd'hui", today_cost, today_out),
                        ("7 j · ici", week_cost, week_out)):
        lines.append(f"   {C_TEXT}{pad(label, 12)}{RESET}"
                     f"{C_INFO}{'~%.2f $' % c:>10}{RESET}"
                     f"{C_DIM}{human_tokens(o):>6} sortie{RESET}")

    lines.append("")
    # Ce n'est PAS la facture : sur abonnement, 286 $ d'équivalent API tiennent
    # dans 21 % du quota hebdomadaire. Le chiffre sert à comparer un projet ou
    # un modèle à un autre, pas à savoir ce qu'on paie.
    per_turn = f" · {today_cost / today_turns:.2f} $/tour" if today_turns else ""
    lines.append(f"   {C_MUTED}≈ équivalent API{per_turn}{RESET}")

    # D'où vient la note, en une ligne : le détail par poste tient en trois
    # parts, le reste est du bruit.
    kinds = ranked(by_kind, top=3)
    if kinds:
        lines.append(f"   {C_MUTED}"
                     + " · ".join(f"{int(v)}% {k}" for k, v in kinds)
                     + f"{RESET}")

    # Par projet puis par modèle, sur 7 jours : une journée seule est trop
    # bruitée pour qu'un classement veuille dire quelque chose.
    for share, labels in ((by_project, names), (by_model, None)):
        rows = ranked(share, labels)
        if not rows:
            continue
        lines.append("")
        for name, pct in rows:
            if labels is None:
                name = name.removeprefix("claude-")
            lines.append(
                f"   {C_TEXT}{pad(trunc(name, 14), 15)}{RESET}"
                f"{C_DIM}{int(pct):>3}%{RESET}  "
                f"{C_MUTED}{bar(pct, 12)}{RESET}")
    return lines


# ── saut vers l'agent ───────────────────────────────────────────────────────
def tmux(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True,
                              text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def ppid_of(pid):
    try:
        with open(f"/proc/{pid}/status") as fh:
            for line in fh:
                if line.startswith("PPid:"):
                    return int(line.split()[1])
    except (OSError, ValueError):
        pass
    return None


def pane_of_pid(pid):
    """Remonte l'arbre des processus jusqu'à tomber sur le pid d'un pane.

    Le champ `tmux` du fichier de session n'est pas toujours renseigné — un
    agent lancé par `claude attach` dans une fenêtre neuve n'en a pas. Et le
    pid du pane est celui du shell, pas de claude : d'où la remontée.
    """
    panes = {}
    for line in tmux("list-panes", "-a", "-F",
                     "#{pane_pid} #{window_id} #{pane_id}").splitlines():
        parts = line.split()
        if len(parts) == 3 and parts[0].isdigit():
            panes[int(parts[0])] = (parts[1], parts[2])
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return None
    for _ in range(20):                    # garde-fou contre un cycle de /proc
        if pid in panes:
            return panes[pid]
        pid = ppid_of(pid)
        if not pid or pid <= 1:
            return None
    return None


def jump(a):
    """Amène l'agent sélectionné sous les yeux.

    Une session interactive a enregistré son emplacement (« session:@fen.%pane »)
    dans son fichier de session : il suffit de l'y suivre. Un agent background
    ne vit dans aucune fenêtre — on lui en ouvre une avec `claude attach`, ce
    que fait aussi la vue agents native sur Entrée.
    """
    loc = a.get("tmux") or ""
    if ":" in loc and "." in loc:
        win, _, pane = loc.split(":", 1)[1].partition(".")
        tmux("select-window", "-t", win)
        if pane:
            tmux("select-pane", "-t", pane)
        return True

    if a.get("pid"):
        found = pane_of_pid(a["pid"])
        if found:
            tmux("select-window", "-t", found[0])
            tmux("select-pane", "-t", found[1])
            return True

    # `claude attach` UNIQUEMENT si l'agent ne tourne pas déjà : sinon on
    # ouvrirait une seconde instance de quelque chose de vivant.
    # L'id vient d'un nom de dossier sous ~/.claude/jobs/ et finit dans une
    # commande shell : on n'accepte que ce à quoi un id ressemble.
    if a.get("id") and not a.get("pid") and re.fullmatch(r"[0-9a-f]{4,64}", a["id"]):
        tmux("new-window", "-n", re.sub(r"[^\w.-]", "_", a.get("name") or "agent")[:20],
             f"claude attach {a['id']}")
        return True

    tmux("display-message", "-d", "2000",
         f"« {a.get('name') or 'agent'} » tourne mais n'est dans aucun pane tmux")
    return False


def dismiss_window():
    """q ferme le pane : on pose le même drapeau que la fermeture manuelle,
    sinon le premier hook venu le rouvrirait."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return
    win = tmux("display-message", "-p", "-t", pane, "#{window_id}")
    if win:
        tmux("set-option", "-w", "-t", win, "@claude_panel_off", "1")


# ── conseils ────────────────────────────────────────────────────────────────
# Seuils au-delà desquels il y a quelque chose à FAIRE. En dessous, la section
# disparaît : un bandeau « tout va bien » permanent n'apprend rien et occupe la
# place de ce qui compte.
CTX_ADVICE = 70             # contexte : au-delà, /compact peut devenir rentable
TURN_COST_ADVICE = 0.05     # ...mais seulement si le tour coûte vraiment
QUOTA_5H_ADVICE = 75
QUOTA_7D_ADVICE = 85
MAX_TIPS = 3


def turn_cost(meta):
    """Coût de lecture de cache d'UN tour de cette session.

    À chaque échange, la session relit tout son contexte. C'est le poste
    dominant — 63 % de la note — et il croît linéairement avec le contexte :
    c'est ce qui rend /compact rentable, bien plus qu'un changement de modèle.
    """
    ctx, window, mid = meta.get("ctx"), meta.get("window"), meta.get("mid")
    p = price(mid) if mid else None
    if ctx is None or not window or not p:
        return None
    return ctx / 100 * window * p[0] * CACHE_READ / 1_000_000


def render_advice(agents, width):
    tips = []

    for a in sorted(agents, key=lambda x: -(session_meta(x.get("sessionId"))[0]
                                            .get("ctx") or 0)):
        meta, stale = session_meta(a.get("sessionId"))
        ctx = meta.get("ctx")
        if stale or ctx is None or ctx < CTX_ADVICE:
            continue
        cost = turn_cost(meta)
        # Un pourcentage élevé ne suffit pas : 72 % d'une fenêtre de 200k sur
        # Haiku, c'est un centime par tour — le conseiller est du bruit. On
        # exige un coût réel, ou un contexte si haut que la compaction
        # s'impose de toute façon.
        if cost is not None and cost < TURN_COST_ADVICE and ctx < 90:
            continue
        name = a.get("name") or (a.get("sessionId") or "?")[:8]
        tips.append((f"{trunc(name, 20)} à {int(ctx)}% de contexte",
                     "/compact" + (f" — ~{cost:.2f} $ par tour sinon" if cost else "")))

    rl, qstale = read_quota()
    if rl and not qstale:
        for key, label, seuil, action in (
                ("five_hour", "5 h", QUOTA_5H_ADVICE,
                 "passer sur un modèle plus léger"),
                ("seven_day", "7 j", QUOTA_7D_ADVICE,
                 "lever le pied jusqu'au reset")):
            w = rl.get(key) or {}
            pct = w.get("used_percentage")
            if pct is None or pct < seuil:
                continue
            left = (w.get("resets_at") or 0) - time.time()
            when = ""
            if left > 0:
                h, mn = int(left // 3600), int((left % 3600) // 60)
                when = f" — réinit. dans {h}h{mn:02d}" if h else f" — réinit. dans {mn}m"
            tips.append((f"quota {label} à {int(pct)}%{when}", action))

    if not tips:
        return []

    lines = section("CONSEILS", width)
    for observation, action in tips[:MAX_TIPS]:
        lines.append(f"   {C_WARN}⚠ {trunc(observation, width - 6)}{RESET}")
        lines.append(f"     {C_MUTED}{trunc(action, width - 6)}{RESET}")
    return lines


# ── rendus ──────────────────────────────────────────────────────────────────
def current_id(agents):
    win = own_window()
    if not win:
        return None
    for a in agents:
        if agent_window(a) == win:
            return a.get("sessionId")
    return None


def frame_full(width, force_cli, selected):
    agents, note = sorted_agents(force_cli)
    current = current_id(agents)
    out = [f"{C_TITLE}{BOLD} CLAUDE{RESET}"
           f"{C_DIM}{datetime.now().strftime('%H:%M'):>{max(0, width - 8)}}{RESET}", ""]
    agent_lines, rows, cells = render_agents(agents, note, width, selected, current)
    rows = {k + len(out): v for k, v in rows.items()}
    cells = [(row + len(out), col) for row, col in cells]
    out.extend(agent_lines)
    for block in ("", render_quota(width), "", render_usage(scan_usage(), width),
                  "", render_advice(agents, width)):
        if block == "":
            out.append("")
        else:
            out.extend(block)
    return out, rows, agents, note, cells


def frame_compact(width, force_cli, _selected):
    """Rendu replié : une colonne d'icônes d'état, le total, puis les quotas.
    Ni noms ni coûts — à cinq colonnes, tout ce qui est tronqué est du bruit."""
    agents, note = sorted_agents(force_cli)
    out, rows, cells = [""], {}, []
    for i, a in enumerate(agents[:8]):
        icon, color, _ = STATE_STYLE.get(agent_state(a), ("·", C_MUTED, ""))
        if a.get("kind") == "background" and not a.get("pid"):
            icon = "∘"
        if is_working(a):
            icon, color = SPINNER[TICK % len(SPINNER)], C_TITLE
            cells.append((len(out) + 1, 2))    # « ␣✽ » : 2e colonne
        rows[len(out)] = i
        out.append(f" {color}{icon}{RESET}")
    out.append(f" {C_DIM}{len(agents)}{RESET}")
    out.append("")

    rl, stale = read_quota()
    for key, label in (("five_hour", "5h"), ("seven_day", "7j")):
        w = (rl or {}).get(key) or {}
        if w.get("used_percentage") is None:
            continue
        pct = int(w["used_percentage"])
        color = C_MUTED if stale else tint(pct)
        out.append(f" {C_MUTED}{label}{RESET}")
        out.append(f"{color}{pct:>3}%{RESET}")
    return out, rows, agents, note, cells


# ── entrées ─────────────────────────────────────────────────────────────────
RESIZED = False
MOUSE = re.compile(rb"\x1b\[<(\d+);(\d+);(\d+)([Mm])")


def on_winch(_sig, _frm):
    global RESIZED
    RESIZED = True


class RawInput:
    """cbreak et non raw : ISIG reste actif, donc Ctrl-C continue de tuer le
    pane normalement. 1006 = coordonnées SGR, sans quoi les colonnes au-delà
    de 223 sont illisibles."""

    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.saved = None

    def __enter__(self):
        if os.isatty(self.fd):
            self.saved = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
            sys.stdout.write("\033[?1000h\033[?1006h")
        return self

    def __exit__(self, *_):
        if self.saved:
            sys.stdout.write("\033[?1000l\033[?1006l")
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)


def parse_input(data):
    events = []
    for m in MOUSE.finditer(data):
        button, row, kind = int(m.group(1)), int(m.group(3)), m.group(4)
        if button == 64:
            events.append(("up", 0))
        elif button == 65:
            events.append(("down", 0))
        elif button == 0 and kind == b"M":
            events.append(("click", row - 1))      # lignes tmux en base 1
    for chunk in MOUSE.sub(b"", data).split(b"\x1b"):
        if chunk[:1] == b"[" and chunk[1:2] in (b"A", b"B"):
            events.append(("up" if chunk[1:2] == b"A" else "down", 0))
            chunk = chunk[2:]
        for byte in chunk:
            c = chr(byte)
            if c == "k":
                events.append(("up", 0))
            elif c == "j":
                events.append(("down", 0))
            elif c in "\r\n":
                events.append(("enter", 0))
            elif c == "q":
                events.append(("quit", 0))
    return events


WAKE = ()


def setup_signals():
    """Tube de réveil : `select` ne rend pas la main sur un signal (PEP 475 le
    relance), mais Python écrit un octet dans ce tube à chaque signal reçu. On
    surveille donc les deux descripteurs et on peut dormir tout le temps de
    l'intervalle au lieu de se réveiller quatre fois par seconde pour rien."""
    global WAKE
    read_fd, write_fd = os.pipe()
    os.set_blocking(read_fd, False)
    os.set_blocking(write_fd, False)
    signal.set_wakeup_fd(write_fd)
    signal.signal(signal.SIGWINCH, on_winch)
    WAKE = (read_fd, write_fd)


def wait_events(interval):
    """Rend la main dès qu'il se passe quelque chose : touche, clic, ou
    redimensionnement du pane. Sinon au bout de l'intervalle."""
    global RESIZED
    end = time.time() + interval
    watch = ([WAKE[0]] if WAKE else []) + ([0] if os.isatty(0) else [])
    while True:
        if RESIZED:
            RESIZED = False
            return []
        left = end - time.time()
        if left <= 0:
            return []
        if not watch:
            time.sleep(left)
            return []
        try:
            ready, _, _ = select.select(watch, [], [], left)
        except (OSError, ValueError):
            return []
        if WAKE and WAKE[0] in ready:
            try:
                os.read(WAKE[0], 256)      # vidange, le drapeau porte le sens
            except OSError:
                pass
        if 0 in ready:
            try:
                data = os.read(0, 4096)
            except OSError:
                return []
            events = parse_input(data)
            if events:
                return events


def term_size(override):
    """(colonnes, lignes). Directement le descripteur, et non COLUMNS : la
    variable d'env n'est pas remise à jour quand tmux redimensionne le pane."""
    try:
        size = os.get_terminal_size(sys.stdout.fileno())
        return (override or size.columns), size.lines
    except OSError:
        return (override or DEFAULT_WIDTH), 0


def draw(once, override, force_cli, selected):
    global TICK
    TICK += 1
    width, height = term_size(override)
    try:
        render = frame_compact if width < COMPACT_UNDER else frame_full
        lines, rows, agents, note, cells = render(width, force_cli, selected)
    except Exception as exc:                       # le pane ne doit jamais mourir
        lines, rows, agents, note, cells = (
            [f"{C_ALERT}claude-panel: {exc}{RESET}"], {}, [], "?", [])
    # Le panneau ne doit jamais dépasser la hauteur du pane : au-delà, tmux
    # fait défiler et l'en-tête disparaît en haut.
    if height:
        lines = lines[:height]
    body = "\n".join(line + "\033[K" for line in lines)
    sys.stdout.write(("" if once else "\033[H") + body + "\033[J\n")
    sys.stdout.flush()
    # None = indécidable (source muette ou hors tmux) : on ne se ferme pas sur
    # un doute.
    here = None if (note or own_window() is None) else bool(current_id(agents))
    return rows, agents, here, cells


def spin(cells):
    """Avance l'animation en ne réécrivant QUE les caractères d'icône.

    Découplé du rafraîchissement des données : une image toutes les 120 ms
    coûte une poignée d'octets, là où un rendu complet coûte ~27 ms de lecture
    de fichiers. C'est ce couplage qui donnait une icône battant lentement au
    lieu de tourner.
    """
    global TICK
    TICK += 1
    frame = SPINNER[TICK % len(SPINNER)]
    out = "".join(f"\033[{row};{col}H{BOLD}{C_TITLE}{frame}{RESET}"
                  for row, col in cells)
    if out:
        sys.stdout.write(out)
        sys.stdout.flush()


def apply_event(kind, row, rows, agents, selected):
    """Retourne (sélection, continuer)."""
    if kind == "quit":
        return selected, False
    if not agents:
        return selected, True

    ids = [a.get("sessionId") for a in agents]
    idx = ids.index(selected) if selected in ids else -1

    if kind == "click":
        if row in rows:
            hit = rows[row]
            # Un clic sur la ligne déjà sélectionnée vaut validation : c'est le
            # double-clic sans avoir à mesurer un délai.
            if ids[hit] == selected:
                jump(agents[hit])
            return ids[hit], True
        return selected, True
    if kind == "up":
        return ids[max(0, idx - 1)] if idx > 0 else ids[0], True
    if kind == "down":
        return ids[min(len(ids) - 1, idx + 1)] if idx >= 0 else ids[0], True
    if kind == "enter" and idx >= 0:
        jump(agents[idx])
    return selected, True


def main():
    argv = sys.argv[1:]
    once, force_cli = "--once" in argv, "--cli" in argv
    interval, override = 5, 0
    for flag in ("-i", "--interval", "--width"):
        if flag in argv:
            try:
                value = int(argv[argv.index(flag) + 1])
                if flag == "--width":
                    override = value
                else:
                    interval = max(1, value)
            except (IndexError, ValueError):
                pass
    if once:
        draw(True, override, force_cli, None)
        return

    setup_signals()
    selected, running, quit_asked, orphan = None, True, False, 0
    with RawInput():
        sys.stdout.write("\033[?25l")              # curseur caché
        try:
            while running:
                rows, agents, here, cells = draw(False, override, force_cli, selected)
                # Un Claude tué brutalement (kill -9, crash, pane fermé) ne
                # déclenche aucun SessionEnd : sans ça, le panneau resterait
                # ouvert dans une fenêtre qui n'a plus rien à montrer. Trois
                # tours d'affilée pour ne pas fermer sur un hoquet de lecture.
                orphan = orphan + 1 if here is False else 0
                if orphan >= 3:
                    break
                # Les données ne sont relues qu'une fois par intervalle ;
                # entre-temps on ne fait qu'avancer l'animation. Sans agent en
                # cours, aucune image à peindre : on dort d'une traite.
                end = time.time() + interval
                while running:
                    left = end - time.time()
                    if left <= 0:
                        break
                    events = wait_events(min(left, SPIN_PERIOD) if cells else left)
                    if events:
                        for kind, row in events:
                            selected, running = apply_event(
                                kind, row, rows, agents, selected)
                            if not running:
                                quit_asked = True
                        break
                    if cells:
                        spin(cells)
        except KeyboardInterrupt:
            pass
        finally:
            sys.stdout.write("\033[?25h\033[0m")
            sys.stdout.flush()
    # Fermeture automatique : surtout PAS de drapeau, sinon la fenêtre resterait
    # marquée « fermée à la main » et le panneau ne reviendrait jamais.
    if quit_asked:
        dismiss_window()


if __name__ == "__main__":
    main()
