#!/usr/bin/env python3
"""Panneau latéral Claude Code — agents en cours, quota, conso.

En python3 et non en bash comme le reste de bin/ : le gros du travail est du
parsing de JSONL incrémental avec cache, ce que bash ne fait pas sans un jq par
ligne. La règle du repo qui tient toujours : aucune couleur codée en dur, tout
vient de ~/.config/theme/current/palette.sh, généré par theme/render.sh.

    claude-panel            boucle, rafraîchit toutes les 5 s (usage tmux)
    claude-panel --once     un seul rendu puis sortie
    claude-panel -i 10      autre intervalle
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path

HOME = Path.home()
CLAUDE = HOME / ".claude"
CACHE = HOME / ".cache" / "claude-panel"
USAGE_CACHE = CACHE / "usage.json"
RATE_CACHE = CACHE / "rate-limits.json"

# $ par million de tokens. Les multiplicateurs de cache sont ceux de l'API :
# lecture 0.1x le prix d'entrée, écriture 1.25x en TTL 5 min et 2x en TTL 1 h.
PRICING = {
    "fable-5": (10.0, 50.0),
    "mythos-5": (10.0, 50.0),
    "opus-5": (5.0, 25.0),
    "opus-4-8": (5.0, 25.0),
    "opus-4-7": (5.0, 25.0),
    "opus-4-6": (5.0, 25.0),
    "sonnet-5": (3.0, 15.0),   # tarif d'intro 2/10 jusqu'au 31/08/2026
    "sonnet-4-6": (3.0, 15.0),
    "haiku-4-5": (1.0, 5.0),
}
CACHE_READ, CACHE_W5M, CACHE_W1H = 0.1, 1.25, 2.0

RETENTION_DAYS = 8


# ── couleurs ────────────────────────────────────────────────────────────────
def load_palette():
    pal, path = {}, HOME / ".config/theme/current/palette.sh"
    try:
        for m in re.finditer(r'export (THEME_\w+)="([^"]*)"', path.read_text()):
            pal[m.group(1)] = m.group(2)
    except OSError:
        pass
    return pal


PAL = load_palette()


def fg(key, fallback="#ffffff"):
    """#rrggbb -> séquence ANSI truecolor. Clé absente = repli neutre."""
    h = PAL.get(key, fallback).lstrip("#")
    if len(h) != 6:
        h = fallback.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
    return f"\033[38;2;{r};{g};{b}m"


RESET = "\033[0m"
BOLD = "\033[1m"
C_TITLE = fg("THEME_ACCENT")
C_TEXT = fg("THEME_FOREGROUND")
C_DIM = fg("THEME_COLOR13")
C_MUTED = fg("THEME_COLOR5")
C_OK = fg("THEME_COLOR10")
C_WARN = fg("THEME_COLOR11")
C_ALERT = fg("THEME_COLOR9")
C_INFO = fg("THEME_COLOR14")


def tint(pct):
    return C_OK if pct < 50 else (C_WARN if pct < 80 else C_ALERT)


# ── mise en forme ───────────────────────────────────────────────────────────
def human_tokens(n):
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.0f}k"
    return str(n)


def human_age(started_ms):
    if not started_ms:
        return ""
    s = max(0, time.time() - started_ms / 1000)
    if s < 60:
        return f"{int(s)}s"
    if s < 3600:
        return f"{int(s // 60)}m"
    if s < 86400:
        return f"{int(s // 3600)}h"
    return f"{int(s // 86400)}j"


def bar(pct, width=10):
    filled = max(0, min(width, round(pct / 100 * width)))
    return "█" * filled + "░" * (width - filled)


def visible_len(s):
    return len(re.sub(r"\033\[[0-9;]*m", "", s))


def pad(s, width):
    return s + " " * max(0, width - visible_len(s))


def trunc(s, width):
    return s if len(s) <= width else s[: max(0, width - 1)] + "…"


# ── agents ──────────────────────────────────────────────────────────────────
def read_agents():
    """`claude agents --json` est la source : elle couvre les sessions
    interactives ET background, avec leur état. Repli sur ~/.claude/sessions/
    (même logique que tmux-claude-status) si la CLI ne répond pas."""
    try:
        out = subprocess.run(
            ["claude", "agents", "--json"],
            capture_output=True, text=True, timeout=5,
        )
        if out.returncode == 0 and out.stdout.strip():
            return json.loads(out.stdout), True
    except (OSError, ValueError, subprocess.SubprocessError):
        pass

    sessions = []
    for f in sorted((CLAUDE / "sessions").glob("*.json")):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        pid = d.get("pid")
        if not pid:
            continue
        try:
            os.kill(int(pid), 0)
        except OSError:
            continue
        sessions.append(d)
    return sessions, False


STATE_STYLE = {
    "blocked": ("✻", C_WARN, "bloqué"),
    "working": ("✽", C_INFO, ""),
    "busy": ("✽", C_INFO, ""),
    "idle": ("∙", C_MUTED, ""),
    "done": ("✓", C_OK, "fini"),
    "failed": ("✗", C_ALERT, "échec"),
    "stopped": ("⏹", C_MUTED, "arrêté"),
}
STATE_ORDER = {"blocked": 0, "working": 1, "busy": 1, "idle": 2,
               "failed": 3, "done": 4, "stopped": 5}


def agent_state(a):
    return a.get("state") or a.get("status") or "idle"


def render_agents(width):
    agents, live = read_agents()
    agents.sort(key=lambda a: (STATE_ORDER.get(agent_state(a), 9),
                               -(a.get("startedAt") or 0)))
    lines = [f"{C_TITLE}{BOLD}AGENTS{RESET}  {C_DIM}{len(agents)}{RESET}"]
    if not live:
        lines.append(f"  {C_MUTED}(repli sessions, CLI muette){RESET}")
    if not agents:
        lines.append(f"  {C_MUTED}aucune session{RESET}")
        return lines

    for a in agents:
        st = agent_state(a)
        icon, color, note = STATE_STYLE.get(st, ("·", C_MUTED, st))
        # Pas de colonne projet : Claude dérive le nom de session du dossier
        # (api-platform-c1, sflow-flamingo-d4…), l'afficher en plus ne ferait
        # que voler la place au nom dans un pane de 34 colonnes.
        name = a.get("name") or Path(a.get("cwd") or "").name \
            or (a.get("sessionId") or "?")[:8]
        right = f"{human_age(a.get('startedAt'))} {note}".strip()
        # Processus mort mais session encore attachable : la vue agents native
        # distingue les deux par la forme de l'icône, on garde l'idée.
        if a.get("kind") == "background" and not a.get("pid"):
            icon = "∘"
        left = f" {icon} {trunc(name, max(8, width - len(right) - 5))}"
        lines.append(
            f"{color}{pad(left, width - len(right) - 1)}{RESET}"
            f"{C_DIM}{right}{RESET}"
        )
    return lines


# ── quota (écrit par la statusline) ─────────────────────────────────────────
def render_quota(width):
    try:
        d = json.loads(RATE_CACHE.read_text())
    except (OSError, ValueError):
        return [
            f"{C_TITLE}{BOLD}QUOTA{RESET}",
            f"  {C_MUTED}en attente d'une session Claude{RESET}",
        ]

    age = time.time() - d.get("at", 0)
    stale = age > 600
    rl = d.get("rate_limits") or {}
    header = f"{C_TITLE}{BOLD}QUOTA{RESET}"
    if stale:
        # Un quota figé affiché comme s'il était frais est pire que pas de
        # quota du tout : la statusline n'a plus tourné depuis 10 min.
        header += f"  {C_MUTED}périmé{RESET}"
    lines = [header]

    for key, label in (("five_hour", "5 h"), ("seven_day", "7 j")):
        w = rl.get(key) or {}
        pct = w.get("used_percentage")
        if pct is None:
            continue
        pct = int(pct)
        color = C_MUTED if stale else tint(pct)
        resets = ""
        if w.get("resets_at"):
            left = w["resets_at"] - time.time()
            if left > 0:
                h, m = int(left // 3600), int((left % 3600) // 60)
                if h >= 24:                       # « ↻ 78h57 » ne se lit pas
                    resets = f"↻ {h // 24}j{h % 24:02d}h"
                elif h:
                    resets = f"↻ {h}h{m:02d}"
                else:
                    resets = f"↻ {m}m"
        lines.append(
            f"  {C_TEXT}{label}{RESET}  {color}{bar(pct)}{RESET} "
            f"{color}{pct:>3}%{RESET}  {C_DIM}{resets}{RESET}"
        )
    if len(lines) == 1:
        lines.append(f"  {C_MUTED}aucun quota rapporté{RESET}")
    return lines


# ── conso (transcripts) ─────────────────────────────────────────────────────
def price(model):
    """Retourne (in, out) $/MTok, ou None si le modèle est inconnu — auquel cas
    on compte les tokens mais pas le coût, plutôt que d'inventer un tarif."""
    m = (model or "").removeprefix("claude-")
    for key, val in PRICING.items():
        if m.startswith(key):
            return val
    return None


def load_cache():
    try:
        d = json.loads(USAGE_CACHE.read_text())
        if d.get("version") == 1:
            return d
    except (OSError, ValueError):
        pass
    return {"version": 1, "cursors": {}, "hours": {}, "seen": {}}


def scan_usage():
    """Agrège les usages des transcripts. Incrémental : un curseur d'octets par
    fichier, seuls les fichiers qui ont grandi sont relus. Sans ça, 169 Mo de
    JSONL seraient reparcourus à chaque rafraîchissement."""
    cache = load_cache()
    cursors, hours, seen = cache["cursors"], cache["hours"], cache["seen"]
    cutoff = datetime.now() - timedelta(days=RETENTION_DAYS)

    for path in (CLAUDE / "projects").glob("*/*.jsonl"):
        key = str(path)
        try:
            size = path.stat().st_size
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if datetime.fromtimestamp(mtime) < cutoff:
            cursors.pop(key, None)
            continue
        start = cursors.get(key, 0)
        if start > size:      # fichier tronqué ou remplacé
            start = 0
        if start == size:
            continue
        try:
            with path.open("rb") as fh:
                fh.seek(start)
                blob = fh.read()
                cursors[key] = fh.tell()
        except OSError:
            continue

        # Une ligne coupée en fin de lecture serait du JSON invalide : on la
        # laisse pour le prochain passage en reculant le curseur d'autant.
        if blob and not blob.endswith(b"\n"):
            tail = blob.rfind(b"\n")
            if tail == -1:
                cursors[key] = start
                continue
            cursors[key] = start + tail + 1
            blob = blob[: tail + 1]

        for raw in blob.split(b"\n"):
            if not raw.strip():
                continue
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            msg = e.get("message") or {}
            usage = msg.get("usage")
            if not usage:
                continue
            ts = e.get("timestamp") or ""
            try:
                when = datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
            except ValueError:
                continue
            if when.replace(tzinfo=None) < cutoff:
                continue
            day = when.strftime("%Y-%m-%d")
            # Dédup : une même réponse peut être réécrite dans un autre
            # transcript (reprise, fork de session) et compterait deux fois.
            uid = f"{msg.get('id') or e.get('uuid')}:{e.get('requestId') or ''}"
            bucket = seen.setdefault(day, [])
            if uid in bucket:
                continue
            bucket.append(uid)

            model = msg.get("model") or "?"
            cc = usage.get("cache_creation") or {}
            w5 = cc.get("ephemeral_5m_input_tokens", 0)
            w1h = cc.get("ephemeral_1h_input_tokens", 0)
            if not (w5 or w1h):
                w5 = usage.get("cache_creation_input_tokens", 0)
            slot = hours.setdefault(when.strftime("%Y-%m-%dT%H"), {}).setdefault(
                model, [0, 0, 0, 0, 0])
            slot[0] += usage.get("input_tokens", 0)
            slot[1] += usage.get("output_tokens", 0)
            slot[2] += w5
            slot[3] += w1h
            slot[4] += usage.get("cache_read_input_tokens", 0)

    keep = cutoff.strftime("%Y-%m-%d")
    for h in [h for h in hours if h[:10] < keep]:
        del hours[h]
    for d in [d for d in seen if d < keep]:
        del seen[d]

    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        tmp = USAGE_CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps(cache))
        tmp.replace(USAGE_CACHE)
    except OSError:
        pass
    return hours


def totals(hours, since_hour):
    per_model, cost, tok = {}, 0.0, 0
    for hkey, models in hours.items():
        if hkey < since_hour:
            continue
        for model, (i, o, w5, w1h, cr) in models.items():
            n = i + o + w5 + w1h + cr
            tok += n
            per_model[model] = per_model.get(model, 0) + n
            p = price(model)
            if p:
                pin, pout = p
                cost += (i * pin + o * pout
                         + w5 * pin * CACHE_W5M
                         + w1h * pin * CACHE_W1H
                         + cr * pin * CACHE_READ) / 1_000_000
    return tok, cost, per_model


def render_usage(width):
    hours = scan_usage()
    now = datetime.now()
    today_tok, today_cost, per_model = totals(hours, now.strftime("%Y-%m-%dT00"))
    week_tok, week_cost, _ = totals(
        hours, (now - timedelta(days=7)).strftime("%Y-%m-%dT%H"))

    lines = [f"{C_TITLE}{BOLD}CONSO{RESET}"]
    for label, t, c in (("aujourd'hui", today_tok, today_cost),
                        ("7 jours", week_tok, week_cost)):
        lines.append(
            f"  {C_TEXT}{pad(label, 11)}{RESET}"
            f"{C_INFO}{human_tokens(t):>7} tok{RESET} "
            f"{C_DIM}~{c:.2f} ${RESET}"
        )
    per_model = {m: n for m, n in per_model.items()
                 if n and not m.startswith("<")}
    if per_model:
        top = sorted(per_model.items(), key=lambda kv: -kv[1])[:3]
        peak = top[0][1] or 1
        lines.append("")
        for model, n in top:
            short = (model or "?").removeprefix("claude-")
            lines.append(
                f"  {C_TEXT}{pad(trunc(short, 10), 11)}{RESET}"
                f"{C_DIM}{human_tokens(n):>6}{RESET} "
                f"{C_MUTED}{bar(n / peak * 100, 8)}{RESET}"
            )
    return lines


# ── rendu ───────────────────────────────────────────────────────────────────
def frame(width):
    out = [f"{C_TITLE}{BOLD} CLAUDE{RESET}"
           f"{C_DIM}{datetime.now().strftime('%H:%M'):>{max(0, width - 8)}}{RESET}",
           ""]
    for section in (render_agents(width), render_quota(width), render_usage(width)):
        out.extend(section)
        out.append("")
    return out


def draw(once):
    width = shutil.get_terminal_size((34, 40)).columns
    try:
        lines = frame(width)
    except Exception as exc:                       # le pane ne doit jamais mourir
        lines = [f"{C_ALERT}claude-panel: {exc}{RESET}"]
    body = "\n".join(line + "\033[K" for line in lines)
    sys.stdout.write(("" if once else "\033[H") + body + "\033[J\n")
    sys.stdout.flush()


def main():
    argv = sys.argv[1:]
    once = "--once" in argv
    interval = 5
    for flag in ("-i", "--interval"):
        if flag in argv:
            try:
                interval = max(1, int(argv[argv.index(flag) + 1]))
            except (IndexError, ValueError):
                pass
    if once:
        draw(True)
        return
    sys.stdout.write("\033[?25l")                  # curseur caché
    try:
        while True:
            draw(False)
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?25h\033[0m")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
