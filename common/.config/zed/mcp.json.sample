{
  "providers": {},
  "context_servers": {
    "<nom-du-serveur>": {
      "source": "custom",
      "enabled": true,
      "command": "npx",
      "args": [
        "mcp-remote",
        "http://localhost:<port>/mcp",
        "--header",
        "x-api-key:${MON_SERVICE_API_KEY}"
      ],
      "env": {}
    }
  }
}
