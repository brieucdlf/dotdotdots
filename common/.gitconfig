# Identité : jamais committée. Deux façons de la retrouver après un reset —
# `dots-secrets unseal` la déchiffre avec la YubiKey, ou bien on recopie
# identity.gitconfig.sample à la main. Tout en haut pour que l'includeIf ~/Work/
# plus bas puisse l'écraser. Fichier absent : git ignore l'include en silence
# puis refuse de committer faute d'email — échec bruyant, donc réparable.
[include]
  path = ~/.config/git/identity.gitconfig

# ── signature des commits ────────────────────────────────────────────────────
# Par SSH, pas par GPG. La clé matérielle sert déjà à s'authentifier ; signer
# avec elle veut dire qu'un commit à ton nom exige une présence physique, et
# qu'une machine compromise ne peut pas en fabriquer. Aucune clé à faire
# expirer, contrairement à GPG.
#
# `user.signingkey` n'est pas ici mais dans identity.gitconfig : c'est un choix
# de POSTE — chaque machine nomme le token qu'elle a sous la main.
[gpg]
  format = ssh

[gpg "ssh"]
  # Sans ce fichier git signe mais ne sait pas vérifier : il lui manque la
  # correspondance entre une adresse et une clé publique.
  allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgsign = true

[core]
  pager = delta
  editor = nvim

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  # 'ansi' = delta rend avec les 16 couleurs du terminal, donc la palette
  # nurburgreen de ghostty. Aucun thème bat externe à installer, et identique
  # sur les deux machines. (Avant : Catppuccin-mocha, un thème bat à part.)
  syntax-theme = ansi

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[alias]
  lg = log --oneline --decorate --graph --all
  sw = switch
  unstage = restore --staged

# Identité pro appliquée automatiquement sous ~/Work — plus besoin de diverger
# entre les deux machines. Le fichier est gitignored (email pro non committé).
[includeIf "gitdir:~/Work/"]
  path = ~/.config/git/work.gitconfig

# gh, sans chemin en dur : il peut venir de pacman comme de mise
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
